{
  // ============================================================
  // STARTUP — skip splash/walkthrough/update-check overhead
  // ============================================================
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.welcomePage.walkthroughs.openOnInstall": false,
  "extensions.ignoreRecommendations": true,
  "extensions.autoUpdate": "off",
  "extensions.autoCheckUpdates": false,
  "update.mode": "manual",
  "update.showReleaseNotes": false,
  // "security.workspace.trust.enabled": false,
  // ============================================================
  // EDITOR RENDERING — less per-frame paint/layout work
  // ============================================================
  "editor.formatOnSave": true,
  "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "editor.fontLigatures": true,
  "editor.fontVariations": false,
  "editor.allowVariableFonts": false,
  "editor.fontSize": 16,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.stickyScroll.enabled": true,
  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.linkedEditing": false,
  "editor.occurrencesHighlight": "off",
  "workbench.list.smoothScrolling": false,
  "workbench.reduceMotion": "on",
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "npm.fetchOnlinePackageInfo": false,
  "breadcrumbs.filePath": "off",
  // ============================================================
  // FILE WATCHING & SEARCH — the single biggest CPU/RAM win
  // on real repos; unwatched/unsearched dirs stop costing you
  // ============================================================
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/dist/**": true,
    "**/build/**": true,
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/dist": true,
    "**/build": true,
  },
  "search.followSymlinks": false,
  "files.autoGuessEncoding": true,
  "files.autoSave": "afterDelay",
  // ============================================================
  // NOTEBOOKS
  // ============================================================
  "notebook.formatOnSave.enabled": true,
  "notebook.globalToolbarShowLabel": "never",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook",
  },
  "jupyter.askForKernelRestart": false,
  // ============================================================
  // GIT — avoid background network polling on every window focus
  // ============================================================
  "git.autofetch": false,
  "git.enableSmartCommit": true,
  "git.allowNoVerifyCommit": true,
  "git.openRepositoryInParentFolders": "never",
  // ============================================================
  // AI / CHAT — fully off (matches your existing intent)
  // ============================================================
  "chat.disableAIFeatures": true,
  "chat.agent.enabled": false,
  "chat.checkpoints.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.settings.showAISearchToggle": false,
  // ============================================================
  // PYTHON — ruff for format+lint, Pylance+Pyrefly hybrid for
  // IntelliSense + fast diagnostics
  // ============================================================
  "ruff.nativeServer": "on",
  "python.analysis.diagnosticsSource": "Pylance + Pyrefly",
  "python.analysis.pyreflyVersion": "",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit",
    },
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off",
    },
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit",
    },
  },
  "prettier.proseWrap": "preserve", // don't fight marksman/markdownlint over hard-wrap width
  "markdown.extension.toc.updateOnSave": true,
  // ============================================================
  // WINDOW / WORKBENCH CHROME
  // ============================================================
  "telemetry.telemetryLevel": "off",
  "window.newWindowProfile": "Default",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.layoutControl.enabled": false,
  "workbench.browser.searchEngine": "none",
  "workbench.browser.dataStorage": "ephemeral",
  "workbench.browser.showInTitleBar": false,
  "workbench.colorTheme": "Tokyo Night",
  "direnv.restart.automatic": true,
  "indentRainbow.indicatorStyle": "light",
  "jupyter.variableExplorerExclude": "module;function;builtin_function_or_method;ABCMeta;type;ModelMetaclass",
  "jupyter.interactiveWindow.codeLens.enable": false,
  "jupyter.interactiveWindow.codeLens.enableGotoCell": false,
  "python.analysis.autoFormatStrings": true,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.typeCheckingMode": "standard",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "leaderkey.arrowIsTwoCharWide": true,
  "whichkey.sortOrder": "alphabetically",
