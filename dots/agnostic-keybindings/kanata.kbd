;; =============================================================================
;; ~/.config/kanata/kanata.kbd
;; Role in the 3-daemon split:
;;   swhkd              → app launches, media keys, system, bar, transparency
;;   xremap             → BSPWM window management + chord sequences
;;   kanata (this file) → mouse right-click binding
;;
;; HOW TO RUN:
;;   kanata --enable-cmd -c ~/.config/kanata/kanata.kbd
;;
;; SETUP (run once, so kanata doesn't need sudo every login):
;;   sudo groupadd uinput
;;   sudo usermod -aG input,uinput $USER
;;   echo 'KERNEL=="uinput", MODE="0660", GROUP="uinput", OPTIONS+="static_node=uinput"' \
;;       | sudo tee /etc/udev/rules.d/99-input.rules
;;   sudo udevadm control --reload-rules && sudo udevadm trigger
;;   (then log out and back in)
;;
;; FINDING YOUR MOUSE DEVICE PATH:
;;   ls /dev/input/by-id/ | grep -i mouse
;;   or: sudo libinput list-devices | grep -B1 -A8 "Capabilities.*pointer"
;;   The path you want usually ends in "-event-mouse".
;;   Example: /dev/input/by-id/usb-Logitech_USB_Receiver-if02-event-mouse
;;
;; AUTOSTART (systemd user service):
;;   Place this file at ~/.config/systemd/user/kanata-mouse.service:
;;
;;   [Unit]
;;   Description=Kanata mouse binding daemon
;;
;;   [Service]
;;   Type=simple
;;   ExecStart=/usr/bin/kanata --enable-cmd -c %h/.config/kanata/kanata.kbd
;;   Restart=on-failure
;;
;;   [Install]
;;   WantedBy=default.target
;;
;;   Then: systemctl --user enable --now kanata-mouse.service
;; =============================================================================


(defcfg
  ;; ── IMPORTANT: set your mouse device path here ──────────────────────────
  ;; Replace the path below. Run the command in the header to find yours.
  ;; If you have multiple mice, list them space-separated:
  ;;   linux-dev /dev/input/by-id/first-mouse /dev/input/by-id/second-mouse
  linux-dev /dev/input/by-id/YOUR-MOUSE-DEVICE-event-mouse

  ;; Pass through every button/axis NOT listed in defsrc unchanged.
  ;; This means left-click, scroll, mouse movement, etc. all work normally.
  process-unmapped-keys yes

  ;; Required to use the (cmd ...) action below.
  ;; The flag --enable-cmd on the command line does the same thing.
  danger-enable-cmd yes
)


;; We only intercept the right mouse button.
;; Every other mouse input passes through because of process-unmapped-keys yes.
(defsrc
  btn-right
)


;; =============================================================================
;; Base layer
;;
;; ORIGINAL sxhkdrc binding:
;;   ~button3
;;       win=$(xdotool getmouselocation --shell | sed -n 's/^WINDOW=\(.*\)/\1/p'); \
;;       type=$(xprop -id "$win" _NET_WM_WINDOW_TYPE 2>/dev/null); \
;;       case "$type" in *DESKTOP*) \
;;           jgmenu --csv-file="$HOME/.config/bspwm/config/jgmenu.txt" \
;;                  --config-file="$HOME/.config/bspwm/config/jgmenurc";; esac
;;
;; WHAT ~ DID: The ~ prefix in sxhkd means "pass-through" — the right-click
;; event was still sent to the application AND the command ran. The (multi ...)
;; action in kanata replicates this: btn-right re-emits the click through the
;; virtual uinput device, and (cmd ...) runs the shell command simultaneously.
;;
;; WHAT CANNOT BE PORTED TO WAYLAND:
;;   1. xdotool — X11 only, doesn't work on Wayland.
;;   2. xprop   — X11 only, doesn't work on Wayland.
;;   3. jgmenu  — X11 only window manager menu, no Wayland support.
;;   4. Desktop-window detection — Wayland has no equivalent to querying
;;      _NET_WM_WINDOW_TYPE. There is no portable way to check whether the
;;      cursor is hovering over a desktop background on Wayland.
;;
;; WAYLAND REPLACEMENT:
;; The menu fires on every right-click rather than only on the desktop.
;; Choose whichever launcher suits your setup:
;;
;;   rofi -show drun &               ← rofi-wayland (most common choice)
;;   wofi --show drun &              ← native Wayland, GTK, lightweight
;;   fuzzel &                        ← native Wayland, minimal, fast
;;   nwg-menu &                      ← designed to mimic jgmenu on Wayland
;;   walker &                        ← GPU-accelerated Wayland launcher
;;
;; The & at the end detaches the process so kanata is not blocked.
;; =============================================================================
(deflayer base
  (multi btn-right (cmd bash -c "rofi -show drun &"))
)
