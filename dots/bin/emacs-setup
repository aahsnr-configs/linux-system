#!/bin/bash
#
# Emacs Daemon First-Time Startup Logger
# Logs output during initial package installation
#

set -euo pipefail

# Configuration
readonly SCRIPT_NAME="$(basename "$0")"
readonly LOG_DIR="${HOME}/.config/emacs/logs"
readonly LOG_FILE="${LOG_DIR}/daemon-startup-$(date +%Y%m%d-%H%M%S).log"
readonly EMACS_BIN="${EMACS_BIN:-emacs}"

# Colors for terminal output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${GREEN}[INFO]${NC} $*" | tee -a "${LOG_FILE}"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $*" | tee -a "${LOG_FILE}"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $*" | tee -a "${LOG_FILE}"
}

# Create log directory if it doesn't exist
mkdir -p "${LOG_DIR}"

# Header
{
    echo "========================================="
    echo "Emacs Daemon First-Time Startup Log"
    echo "Date: $(date)"
    echo "Host: $(hostname)"
    echo "User: $(whoami)"
    echo "Emacs: $(command -v "${EMACS_BIN}")"
    echo "========================================="
    echo ""
} | tee "${LOG_FILE}"

log_info "Starting Emacs daemon initialization..."
log_info "Log file: ${LOG_FILE}"

# Kill any existing Emacs processes
if pgrep -x emacs > /dev/null; then
    log_warn "Existing Emacs processes found. Stopping them..."
    killall emacs 2>/dev/null || true
    sleep 2
    
    # Force kill if still running
    if pgrep -x emacs > /dev/null; then
        log_warn "Force killing remaining processes..."
        killall -9 emacs 2>/dev/null || true
        sleep 1
    fi
    log_info "All Emacs processes stopped"
fi

# Tangle config if it exists
if [[ -f "${HOME}/.config/emacs/config.org" ]]; then
    log_info "Tangling Org configuration..."
    if "${EMACS_BIN}" --batch \
        --eval "(require 'org)" \
        --eval '(org-babel-tangle-file "~/.config/emacs/config.org")' \
        >> "${LOG_FILE}" 2>&1; then
        log_info "Configuration tangled successfully"
    else
        log_error "Failed to tangle configuration"
        exit 1
    fi
fi

# Start daemon and capture all output
log_info "Starting Emacs daemon (this may take a while for first-time package installation)..."
log_info "----------------------------------------"

# Use a temporary file for daemon output
DAEMON_OUTPUT=$(mktemp)
trap 'rm -f "${DAEMON_OUTPUT}"' EXIT

# Start daemon in foreground mode to capture output
if "${EMACS_BIN}" --fg-daemon 2>&1 | tee -a "${LOG_FILE}" "${DAEMON_OUTPUT}"; then
    log_info "----------------------------------------"
    log_info "Emacs daemon started successfully"
    
    # Check if packages were installed
    if grep -iq "package" "${DAEMON_OUTPUT}" || grep -iq "install" "${DAEMON_OUTPUT}"; then
        log_info "Package installation detected in output"
    fi
    
    # Verify daemon is running
    if pgrep -x emacs > /dev/null; then
        log_info "Daemon process confirmed running (PID: $(pgrep -x emacs))"
    else
        log_warn "Daemon process not found, may have backgrounded"
    fi
else
    EXIT_CODE=$?
    log_error "Emacs daemon failed to start (exit code: ${EXIT_CODE})"
    log_error "Check the log file for details: ${LOG_FILE}"
    exit "${EXIT_CODE}"
fi

# Summary
echo ""
log_info "Startup complete!"
log_info "Full log saved to: ${LOG_FILE}"
log_info "To view the log: less ${LOG_FILE}"
log_info "To connect to daemon: emacsclient -c"

exit 0
