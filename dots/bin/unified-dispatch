#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
# unified-dispatch — Hyprland ≥0.54 layout-aware window dispatcher
# ══════════════════════════════════════════════════════════════════════════════
#
# Usage:  unified-dispatch <action> <direction>
#           action    : focus | movewin | resize
#           direction : l | r | u | d
#
# Dependency: jq
#
# ── Why layout detection uses a static table ─────────────────────────────────
#
# Hyprland v0.54 added per-workspace layouts but `hyprctl activeworkspace -j`
# only populates the `.layout` field for the *new* layouts (scrolling, monocle).
# For the pre-existing dwindle and master layouts the field is absent/null.
# hyprland-rs (the community Rust IPC wrapper) confirms this: its Workspace
# struct has no layout field at all, meaning the library authors also never
# saw it populated reliably.
#
# `hyprctl workspacerules -j` does not expose a layout field in its JSON
# objects either — the layout keyword is a config-parsing artefact only.
#
# Falling back to `general:layout` silently routes dwindle/master workspaces
# through the wrong dispatcher when the global default is "scrolling".
#
# The WS_LAYOUT table below is the only 100%-reliable source. It mirrors
# workspaces.conf exactly. Edit it whenever you change workspaces.conf.
# ─────────────────────────────────────────────────────────────────────────────

# ── WORKSPACE → LAYOUT TABLE ──────────────────────────────────────────────────
# Keys   : workspace IDs (integers from `hyprctl activeworkspace -j` → .id)
# Values : scrolling | dwindle | master | monocle
# ─────────────────────────────────────────────────────────────────────────────
declare -A WS_LAYOUT=(
    [1]=scrolling
    [2]=scrolling
    [3]=scrolling
    [4]=dwindle
    [5]=dwindle
    [6]=dwindle
    [7]=master
    [8]=master
    [9]=monocle
)

# ── Validation ────────────────────────────────────────────────────────────────
ACTION="$1"
DIRECTION="$2"

if [[ -z "$ACTION" || -z "$DIRECTION" ]]; then
    printf 'Usage: %s {focus|movewin|resize} {l|r|u|d}\n' "$(basename "$0")" >&2
    exit 1
fi

if [[ ! "$DIRECTION" =~ ^(l|r|u|d)$ ]]; then
    printf 'Error: direction must be l, r, u, or d  (got: "%s")\n' "$DIRECTION" >&2
    exit 1
fi

# ── dispatch helper ───────────────────────────────────────────────────────────
# `--` stops hyprctl treating negative delta values (e.g. `-60`) as its flags.
dispatch() {
    hyprctl dispatch -- "$@" >/dev/null 2>&1
}

# ── get_active_layout ─────────────────────────────────────────────────────────
# Tier 1: IPC .layout — only trust it if it returns a known layout name.
#         Works today for scrolling/monocle; will work for dwindle/master
#         automatically if Hyprland ever fixes the IPC for those layouts.
# Tier 2: WS_LAYOUT table — always correct, derived from workspaces.conf.
# No further fallback: unknown workspace → loud error, not silent mis-dispatch.
# ─────────────────────────────────────────────────────────────────────────────
get_active_layout() {
    local ws_json ws_id layout

    ws_json=$(hyprctl activeworkspace -j 2>/dev/null)
    ws_id=$(printf '%s' "$ws_json" | jq -r '.id // empty' 2>/dev/null)

    # Tier 1: IPC (only trust validated layout names)
    layout=$(printf '%s' "$ws_json" | jq -r '.layout // empty' 2>/dev/null | tr '[:upper:]' '[:lower:]')
    case "$layout" in
    scrolling | dwindle | master | monocle)
        printf '%s' "$layout"
        return
        ;;
    esac

    # Tier 2: static table
    if [[ -n "$ws_id" && "${WS_LAYOUT[$ws_id]+set}" == "set" ]]; then
        printf '%s' "${WS_LAYOUT[$ws_id]}"
        return
    fi

    printf 'Error: workspace "%s" not in WS_LAYOUT table in %s\n' \
        "$ws_id" "$(basename "$0")" >&2
    exit 1
}

LAYOUT=$(get_active_layout)

# ── Dispatcher reference (v0.54) ──────────────────────────────────────────────
#
#  Layout    │ FOCUS                        │ MOVE WINDOW
#  ──────────┼──────────────────────────────┼──────────────────────────────────
#  scrolling │ layoutmsg focus <l|r|u|d>    │ layoutmsg swapcol l/r  (columns)
#            │                              │ movewindow u/d  (within column)
#            │ NOTE: `layoutmsg move ±col`  │
#            │  pans VIEWPORT, not focus    │
#  dwindle   │ movefocus <l|r|u|d>          │ movewindow <l|r|u|d>
#  master    │ layoutmsg cyclenext/prev     │ layoutmsg rollnext/rollprev
#            │                              │ (swapnext/swapprev removed v0.54)
#  monocle   │ layoutmsg cyclenext/prev     │ layoutmsg cyclenext/prev
#            │ (bare `cyclenext` is broken  │
#            │  in monocle — use layoutmsg) │
#
#  Layout    │ RESIZE
#  ──────────┼──────────────────────────────────────────────────────────────────
#  scrolling │ layoutmsg colresize ±0.05  (l/r — column width, proportional)
#            │ resizeactive 0 ±60         (u/d — window height within column)
#  all other │ resizeactive ±60 0 / 0 ±60 (layout-agnostic)
# ─────────────────────────────────────────────────────────────────────────────

case "$ACTION" in

focus)
    case "$LAYOUT" in
    scrolling)
        dispatch layoutmsg "focus $DIRECTION"
        ;;
    master | monocle)
        case "$DIRECTION" in
        r | d) dispatch layoutmsg cyclenext ;;
        l | u) dispatch layoutmsg cycleprev ;;
        esac
        ;;
    dwindle | *)
        dispatch movefocus "$DIRECTION"
        ;;
    esac
    ;;

movewin)
    case "$LAYOUT" in
    scrolling)
        case "$DIRECTION" in
        l) dispatch layoutmsg "swapcol l" ;;
        r) dispatch layoutmsg "swapcol r" ;;
        u | d) dispatch movewindow "$DIRECTION" ;;
        esac
        ;;
    master)
        case "$DIRECTION" in
        r | d) dispatch layoutmsg rollnext ;;
        l | u) dispatch layoutmsg rollprev ;;
        esac
        ;;
    monocle)
        case "$DIRECTION" in
        r | d) dispatch layoutmsg cyclenext ;;
        l | u) dispatch layoutmsg cycleprev ;;
        esac
        ;;
    dwindle | *)
        dispatch movewindow "$DIRECTION"
        ;;
    esac
    ;;

resize)
    case "$LAYOUT" in
    scrolling)
        case "$DIRECTION" in
        l) dispatch layoutmsg "colresize -0.05" ;;
        r) dispatch layoutmsg "colresize +0.05" ;;
        u) dispatch resizeactive 0 -60 ;;
        d) dispatch resizeactive 0 60 ;;
        esac
        ;;
    *)
        case "$DIRECTION" in
        l) dispatch resizeactive -60 0 ;;
        r) dispatch resizeactive 60 0 ;;
        u) dispatch resizeactive 0 -60 ;;
        d) dispatch resizeactive 0 60 ;;
        esac
        ;;
    esac
    ;;

*)
    printf 'Error: unknown action "%s". Use: focus | movewin | resize\n' "$ACTION" >&2
    exit 1
    ;;
esac
