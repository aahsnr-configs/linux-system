#!/usr/bin/env bash
#
# Multi-Account GitHub SSH, Git, and Encryption Setup Script
#
# This script configures SSH keys (Ed25519), Git settings, GitHub CLI,
# and transparent repository encryption (git-crypt + GPG) for multiple
# GitHub accounts with proper isolation and automatic switching based on
# directory location.
#
# Features:
# - AUTOMATIC cleanup of existing SSH, Git, and GitHub CLI configurations
#   (now scoped to only managed keys and known config files)
# - OS detection: Arch Linux (pacman) and Gentoo (emerge)
# - Generates Ed25519 SSH keys (modern, secure, fast)
# - Generates Ed25519/Cv25519 GPG keys — one per account (passphrase protected)
# - Configures SSH config with host aliases
# - Sets up Git with conditional includes for directory-based account switching
# - Configures GitHub CLI for multiple accounts
# - Sets up git-crypt encryption on all repositories across all accounts
#   (deep discovery up to 3 levels)
# - Exports symmetric backup keys to ~/.gnupg/git-crypt-keys/
# - Configures gpg-agent with sane cache TTLs and safe launch
# - Comprehensive backup before deletion
# - Comprehensive error handling and validation
# - Proper ANSI color rendering (fish shell compatible)
#
# Requirements: git, ssh-keygen, gpg, git-crypt (auto-installed), gh (optional)
# Compatible with: Arch Linux, Gentoo Linux
# Shell Compatibility: bash (works when executed from fish shell)
#
# License: GPL-3.0
# Version: 4.1.0

set -euo pipefail
shopt -s nullglob

# =============================================================================
# CONSTANTS AND CONFIGURATION
# =============================================================================

readonly SCRIPT_VERSION="4.1.0"
readonly SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
readonly SSH_DIR="${HOME}/.ssh"
readonly GIT_CONFIG="${HOME}/.gitconfig"
readonly GIT_XDG_CONFIG="${HOME}/.config/git"
readonly GIT_BASE_DIR="${HOME}/Git"
readonly GH_CONFIG_DIR="${HOME}/.config/gh"
readonly BACKUP_DIR="${HOME}/.config_backups/github_setup_$(date +%Y%m%d_%H%M%S)"
readonly GNUPG_DIR="${HOME}/.gnupg"
readonly GPG_CRYPT_KEY_DIR="${GNUPG_DIR}/git-crypt-keys"

# Detect operating system
readonly OS_TYPE="$(uname -s)"
readonly IS_MACOS=$([[ "${OS_TYPE}" == "Darwin" ]] && echo "true" || echo "false")

# Detect Linux distribution
detect_distro() {
    if [[ -f /etc/arch-release ]]; then
        echo "arch"
    elif [[ -f /etc/gentoo-release ]]; then
        echo "gentoo"
    elif [[ -f /etc/os-release ]]; then
        # shellcheck source=/dev/null
        source /etc/os-release
        case "${ID:-}" in
            arch)   echo "arch" ;;
            gentoo) echo "gentoo" ;;
            *)      echo "unknown" ;;
        esac
    else
        echo "unknown"
    fi
}
readonly DISTRO="$(detect_distro)"

# Minimum required versions
readonly MIN_GIT_VERSION="2.13"

# Color codes (only use in interactive terminals)
if [[ -t 1 ]]; then
    readonly RED='\033[0;31m'
    readonly GREEN='\033[0;32m'
    readonly YELLOW='\033[1;33m'
    readonly BLUE='\033[0;34m'
    readonly CYAN='\033[0;36m'
    readonly BOLD='\033[1m'
    readonly NC='\033[0m'
else
    readonly RED="" GREEN="" YELLOW="" BLUE="" CYAN="" BOLD="" NC=""
fi

# Account configurations — modify these for your accounts
declare -A ACCOUNTS=(
    ["configs"]="ahsanur041@proton.me"
    ["personal"]="ahsanur041@gmail.com"
    ["work"]="aahsnr041@proton.me"
    ["common"]="ahsan.05rahman@gmail.com"
)

declare -A GIT_NAMES=(
    ["configs"]="aahsnr-configs"
    ["personal"]="aahsnr-personal"
    ["work"]="aahsnr-work"
    ["common"]="aahsnr-common"
)

declare -A GIT_DIRS=(
    ["personal"]="${GIT_BASE_DIR}/personal"
    ["work"]="${GIT_BASE_DIR}/work"
    ["common"]="${GIT_BASE_DIR}/common"
)

# Temporary files for atomic operations
declare -a TEMP_FILES=()

# =============================================================================
# ERROR HANDLING AND CLEANUP
# =============================================================================

cleanup() {
    local exit_code=$?
    for temp_file in "${TEMP_FILES[@]}"; do
        if [[ -f "${temp_file}" ]]; then
            rm -f "${temp_file}" 2>/dev/null || true
        fi
    done
    if [[ ${exit_code} -ne 0 ]]; then
        print_error "Script exited with error code ${exit_code}"
    fi
    exit "${exit_code}"
}

error_handler() {
    local line_number="$1"
    local exit_code="$2"
    print_error "Error on line ${line_number}: Command failed with exit code ${exit_code}"
}

trap cleanup EXIT INT TERM
trap 'error_handler ${LINENO} $?' ERR

# =============================================================================
# UTILITY FUNCTIONS
# =============================================================================

print_header() {
    echo -e "${BOLD}${CYAN}"
    echo "╔════════════════════════════════════════════════════════════════════╗"
    echo "║   Multi-Account GitHub Setup + Encryption Script v${SCRIPT_VERSION}      ║"
    echo "║   SSH (Ed25519) + GPG + git-crypt + GitHub CLI                   ║"
    echo "╚════════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
}

print_error()   { echo -e "${RED}✗ Error: $*${NC}" >&2; }
print_success() { echo -e "${GREEN}✓ $*${NC}"; }
print_warning() { echo -e "${YELLOW}⚠ Warning: $*${NC}"; }
print_info()    { echo -e "${BLUE}→ $*${NC}"; }
print_section() { echo ""; echo -e "${BOLD}${BLUE}═══ $* ═══${NC}"; echo ""; }

confirm() {
    local prompt="$1"
    local response
    while true; do
        read -r -p "$(echo -e "${YELLOW}${prompt} [y/N]: ${NC}")" response
        case "${response}" in
            [Yy]|[Yy][Ee][Ss]) return 0 ;;
            [Nn]|[Nn][Oo]|"") return 1 ;;
            *) echo "Please answer yes or no." ;;
        esac
    done
}

backup_item() {
    local item="$1"
    local item_name
    item_name=$(basename "${item}")
    if [[ -e "${item}" ]]; then
        mkdir -p "${BACKUP_DIR}"
        local backup_path="${BACKUP_DIR}/${item_name}"
        if cp -r "${item}" "${backup_path}" 2>/dev/null; then
            print_success "Backed up ${item} → ${backup_path}"
            return 0
        else
            print_error "Failed to backup ${item}"
            return 1
        fi
    fi
    return 0
}

command_exists() { command -v "$1" &>/dev/null; }

version_ge() {
    printf '%s\n%s\n' "${2}" "${1}" | sort -V -C 2>/dev/null
}

# =============================================================================
# DISTRO-SPECIFIC PACKAGE INSTALLATION
# =============================================================================

install_package_arch() {
    local pkg="$1"
    print_info "Installing ${pkg} via pacman..."
    if sudo pacman -S --noconfirm --needed "${pkg}"; then
        print_success "Installed: ${pkg}"
    else
        print_error "Failed to install ${pkg}"
        return 1
    fi
}

install_package_gentoo() {
    local pkg="$1"
    print_info "Installing ${pkg} via emerge..."
    if sudo emerge --ask=n --quiet-build "${pkg}"; then
        print_success "Installed: ${pkg}"
    else
        print_error "Failed to install ${pkg}"
        return 1
    fi
}

install_package() {
    local pkg_arch="$1"
    local pkg_gentoo="${2:-${pkg_arch}}"  # fallback to same name if not given
    case "${DISTRO}" in
        arch)   install_package_arch   "${pkg_arch}" ;;
        gentoo) install_package_gentoo "${pkg_gentoo}" ;;
        *)
            print_warning "Unknown distro '${DISTRO}'. Please install '${pkg_arch}' manually."
            return 1
            ;;
    esac
}

# =============================================================================
# COMPREHENSIVE CLEANUP FUNCTIONS (FIXED C-2: scoped SSH key removal)
# =============================================================================

cleanup_all_configs() {
    print_section "Comprehensive Configuration Cleanup"

    print_warning "${BOLD}This will DELETE the following configurations:${NC}"
    echo ""
    echo "  1. SSH keys matching 'id_ed25519_aahsnr_*' (managed by this script)"
    echo "  2. ~/.ssh/config (will be regenerated)"
    echo "  3. Global Git config:            ${GIT_CONFIG}"
    echo "  4. XDG Git config:               ${GIT_XDG_CONFIG}"
    echo "  5. Directory Git configs in:     ${GIT_BASE_DIR}"
    echo "  6. GitHub CLI config:            ${GH_CONFIG_DIR}"
    echo ""
    echo -e "${CYAN}All files will be backed up to: ${BACKUP_DIR}${NC}"
    echo -e "${YELLOW}Non‑managed SSH keys and other .ssh files WILL BE LEFT UNTOUCHED.${NC}"
    echo ""

    if ! confirm "Do you want to proceed with FULL cleanup?"; then
        print_info "Cleanup cancelled. Exiting."
        exit 0
    fi

    echo ""
    print_info "Creating backup directory..."
    mkdir -p "${BACKUP_DIR}"
    print_success "Backup directory created: ${BACKUP_DIR}"
    echo ""

    local items_deleted=0

    # 1. SSH keys: only those matching our pattern
    if [[ -d "${SSH_DIR}" ]]; then
        print_info "Backing up and removing managed SSH keys..."
        local key_deleted=0
        for key in "${SSH_DIR}"/id_ed25519_aahsnr_*; do
            if [[ -f "${key}" ]]; then
                backup_item "${key}" && rm -f "${key}" && ((key_deleted++)) || true
                local pub="${key}.pub"
                if [[ -f "${pub}" ]]; then
                    backup_item "${pub}" && rm -f "${pub}" || true
                fi
            fi
        done
        if [[ ${key_deleted} -gt 0 ]]; then
            print_success "Removed ${key_deleted} managed SSH key(s)"
        else
            print_info "No managed SSH keys found"
        fi
        ((items_deleted+=key_deleted)) || true
    fi

    # 2. SSH config
    if [[ -f "${SSH_DIR}/config" ]]; then
        backup_item "${SSH_DIR}/config" && rm -f "${SSH_DIR}/config"
        print_success "Removed existing SSH config (will be regenerated)"
        ((items_deleted++)) || true
    fi

    # 3. Global gitconfig
    if [[ -f "${GIT_CONFIG}" ]]; then
        backup_item "${GIT_CONFIG}" && rm -f "${GIT_CONFIG}"
        print_success "Removed: ${GIT_CONFIG}"
        ((items_deleted++)) || true
    fi

    # 4. XDG git config directory
    if [[ -d "${GIT_XDG_CONFIG}" ]]; then
        backup_item "${GIT_XDG_CONFIG}" && rm -rf "${GIT_XDG_CONFIG}"
        print_success "Removed: ${GIT_XDG_CONFIG}"
        ((items_deleted++)) || true
    fi

    # 5. Directory-specific gitconfigs
    if [[ -d "${GIT_BASE_DIR}" ]]; then
        print_info "Scanning for directory-specific Git configs..."
        local found_configs=0
        for dir in "${GIT_BASE_DIR}"/*; do
            [[ -d "${dir}" ]] || continue
            local git_config="${dir}/.gitconfig"
            if [[ -f "${git_config}" ]]; then
                backup_item "${git_config}" && rm -f "${git_config}"
                print_success "Removed: ${git_config}"
                ((found_configs++)) || true
            fi
        done
        if [[ ${found_configs} -gt 0 ]]; then
            print_success "Removed ${found_configs} directory‑specific config(s)"
        else
            print_info "No directory-specific Git configs found"
        fi
        ((items_deleted+=found_configs)) || true
    fi

    # 6. GitHub CLI config
    if [[ -d "${GH_CONFIG_DIR}" ]]; then
        backup_item "${GH_CONFIG_DIR}" && rm -rf "${GH_CONFIG_DIR}"
        print_success "Removed: ${GH_CONFIG_DIR}"
        ((items_deleted++)) || true
    fi

    echo ""
    if [[ ${items_deleted} -gt 0 ]]; then
        print_success "Cleanup complete! ${items_deleted} item(s) removed."
    else
        print_info "No existing configurations found to remove."
    fi
    print_info "Backups saved to: ${BACKUP_DIR}"

    echo ""
    print_info "Starting fresh configuration setup..."
}

# =============================================================================
# DEPENDENCY CHECKING
# =============================================================================

check_dependencies() {
    print_section "Checking Dependencies"

    print_info "Detected OS:     ${OS_TYPE}"
    print_info "Detected distro: ${DISTRO}"
    echo ""

    local missing_deps=()
    local all_good=true

    for cmd in git ssh-keygen ssh gpg; do
        if command_exists "${cmd}"; then
            print_success "${cmd} found"
        else
            print_error "${cmd} not found"
            missing_deps+=("${cmd}")
            all_good=false
        fi
    done

    # Check Git version
    if command_exists git; then
        local git_version
        git_version=$(git --version | grep -oP '\d+\.\d+' | head -1)
        if version_ge "${git_version}" "${MIN_GIT_VERSION}"; then
            print_success "Git version ${git_version} (>= ${MIN_GIT_VERSION} required)"
        else
            print_error "Git version ${git_version} is too old (>= ${MIN_GIT_VERSION} required)"
            all_good=false
        fi
    fi

    # Check git-crypt (optional at check time — installed in setup_encryption)
    if command_exists git-crypt; then
        local gc_version
        gc_version=$(git-crypt --version 2>/dev/null || echo "unknown")
        print_success "git-crypt found: ${gc_version}"
    else
        print_warning "git-crypt not found (will be installed during encryption setup)"
    fi

    # Check GitHub CLI (optional)
    if command_exists gh; then
        local gh_version
        gh_version=$(gh --version 2>/dev/null | head -1 | grep -oP '\d+\.\d+\.\d+' || echo "unknown")
        print_success "GitHub CLI (gh) found: version ${gh_version}"
    else
        print_warning "GitHub CLI (gh) not found (optional but recommended)"
        print_info "Install from: https://cli.github.com/"
    fi

    if [[ ${all_good} == false ]]; then
        echo ""
        print_error "Missing required dependencies: ${missing_deps[*]}"
        print_info "Please install missing dependencies and try again."
        exit 1
    fi

    print_success "All required dependencies satisfied"
}

# =============================================================================
# SSH KEY MANAGEMENT
# =============================================================================

generate_ssh_keys() {
    print_section "Generating SSH Keys (Ed25519)"

    mkdir -p "${SSH_DIR}"
    chmod 700 "${SSH_DIR}"

    print_info "Using Ed25519 algorithm (modern, secure, fast)"
    echo ""

    local generated=0

    for account in "${!ACCOUNTS[@]}"; do
        local email="${ACCOUNTS[${account}]}"
        local key_file="${SSH_DIR}/id_ed25519_aahsnr_${account}"

        if [[ -f "${key_file}" ]]; then
            print_info "Key for ${account} already exists: ${key_file}"
            continue
        fi

        print_info "Generating Ed25519 key for ${account} (${email})..."

        if ssh-keygen -t ed25519 -a 100 -C "${email}" -f "${key_file}" -N "" -q; then
            chmod 600 "${key_file}"
            chmod 644 "${key_file}.pub"

            if ssh-keygen -lf "${key_file}" &>/dev/null; then
                print_success "Generated key for ${account}"
                ((generated++)) || true
            else
                print_error "Key generation appeared to succeed but verification failed"
                return 1
            fi
        else
            print_error "Failed to generate key for ${account}"
            return 1
        fi
    done

    if [[ ${generated} -eq 0 ]]; then
        print_info "All SSH keys already exist"
    else
        print_success "Generated ${generated} new SSH key(s)"
    fi
}

# =============================================================================
# SSH CONFIG MANAGEMENT
# =============================================================================

configure_ssh() {
    print_section "Configuring SSH"

    local ssh_config="${SSH_DIR}/config"
    local temp_config
    temp_config=$(mktemp "${SSH_DIR}/.config.XXXXXX")
    TEMP_FILES+=("${temp_config}")

    cat > "${temp_config}" <<'HEADER'
# =============================================================================
# Multi-Account GitHub SSH Configuration
# Generated by github_multi_account_setup.sh
# =============================================================================

# Default settings for all hosts
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
HEADER

    if [[ "${IS_MACOS}" == "true" ]]; then
        cat >> "${temp_config}" <<'MACOS_CONFIG'
    UseKeychain yes
MACOS_CONFIG
    fi

    echo "" >> "${temp_config}"

    for account in configs personal work common; do
        if [[ -v ACCOUNTS[${account}] ]]; then
            local key_file="${SSH_DIR}/id_ed25519_aahsnr_${account}"
            cat >> "${temp_config}" <<EOF
# GitHub Account: ${account} (${ACCOUNTS[${account}]})
Host github.com-aahsnr-${account}
    HostName github.com
    User git
    IdentityFile ${key_file}
    PreferredAuthentications publickey

EOF
        fi
    done

    cat >> "${temp_config}" <<EOF
# Default GitHub (uses configs account)
Host github.com
    HostName github.com
    User git
    IdentityFile ${SSH_DIR}/id_ed25519_aahsnr_configs
    PreferredAuthentications publickey
EOF

    if mv "${temp_config}" "${ssh_config}"; then
        chmod 600 "${ssh_config}"
        print_success "SSH config created: ${ssh_config}"
    else
        print_error "Failed to create SSH config"
        return 1
    fi
}

# =============================================================================
# GIT CONFIG MANAGEMENT
# =============================================================================

configure_git() {
    print_section "Configuring Git"

    local temp_config
    temp_config=$(mktemp)
    TEMP_FILES+=("${temp_config}")

    cat > "${temp_config}" <<EOF
# =============================================================================
# Multi-Account Git Configuration
# Generated by github_multi_account_setup.sh
# =============================================================================

[user]
    name = ${GIT_NAMES[configs]}
    email = ${ACCOUNTS[configs]}

[core]
    editor = vim
    autocrlf = input
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[diff]
    colorMoved = zebra

[merge]
    conflictstyle = diff3

[rerere]
    enabled = true

EOF

    for account in personal work common; do
        if [[ -v GIT_DIRS[${account}] ]]; then
            local dir="${GIT_DIRS[${account}]}"
            cat >> "${temp_config}" <<EOF
[includeIf "gitdir:${dir}/"]
    path = ${dir}/.gitconfig

EOF
        fi
    done

    if mv "${temp_config}" "${GIT_CONFIG}"; then
        chmod 644 "${GIT_CONFIG}"
        print_success "Main Git config created: ${GIT_CONFIG}"
    else
        print_error "Failed to create main Git config"
        return 1
    fi

    for account in personal work common; do
        if [[ -v GIT_DIRS[${account}] ]]; then
            local dir="${GIT_DIRS[${account}]}"
            local dir_config="${dir}/.gitconfig"

            mkdir -p "${dir}"

            cat > "${dir_config}" <<EOF
# Git configuration for ${account} projects
[user]
    name = ${GIT_NAMES[${account}]}
    email = ${ACCOUNTS[${account}]}
EOF

            chmod 644 "${dir_config}"
            print_success "Created ${account} Git config: ${dir_config}"
        fi
    done
}

# =============================================================================
# SSH AGENT SETUP (FIX H-1: no orphaned agent, only add if agent is usable)
# =============================================================================

setup_ssh_agent() {
    print_section "Setting Up SSH Agent"

    # Check if an agent is already running and reachable
    if ssh-add -l &>/dev/null; then
        print_success "SSH agent already running and functional"
    else
        print_warning "No running SSH agent detected."
        print_info "Please start an agent manually. Examples:"
        print_info "  eval \$(ssh-agent)   # add to ~/.bashrc / ~/.profile"
        print_info "  systemctl --user enable --now ssh-agent  # on systemd systems"
        print_info "Keys will not be loaded now. Add them later with: ssh-add ~/.ssh/id_ed25519_aahsnr_<account>"
        return 0
    fi

    local added=0
    local already=0

    for account in "${!ACCOUNTS[@]}"; do
        local key_file="${SSH_DIR}/id_ed25519_aahsnr_${account}"

        if [[ ! -f "${key_file}" ]]; then
            print_warning "Key file not found for ${account}: ${key_file}"
            continue
        fi

        local key_fp
        key_fp=$(ssh-keygen -lf "${key_file}" 2>/dev/null | awk '{print $2}')

        if [[ -z "${key_fp}" ]]; then
            print_warning "Could not get fingerprint for ${account} key"
            continue
        fi

        if ssh-add -l 2>/dev/null | grep -q "${key_fp}"; then
            print_info "Key for ${account} already loaded"
            ((already++)) || true
        else
            print_info "Adding key for ${account} to agent..."
            if ssh-add "${key_file}" 2>/dev/null; then
                print_success "Added key for ${account}"
                ((added++)) || true
            else
                print_warning "Could not add key for ${account}"
            fi
        fi
    done

    [[ ${added} -gt 0 ]] && print_success "Added ${added} key(s) to SSH agent"
    [[ ${already} -gt 0 ]] && print_info "${already} key(s) already in SSH agent"
}

# =============================================================================
# GITHUB CLI CONFIGURATION
# =============================================================================

configure_github_cli() {
    print_section "Configuring GitHub CLI"

    if ! command_exists gh; then
        print_warning "GitHub CLI not installed. Skipping gh configuration."
        print_info "Install from: https://cli.github.com/"
        return 0
    fi

    print_info "GitHub CLI is installed"
    print_info "You can authenticate later with: gh auth login"
    print_info "To switch between accounts: gh auth switch"

    if gh config set git_protocol ssh 2>/dev/null; then
        print_success "Set GitHub CLI to use SSH protocol"
    fi
}

# =============================================================================
# GPG TOOLS
# =============================================================================

gpg_key_exists() {
    local email="$1"
    gpg --list-secret-keys --keyid-format LONG "${email}" &>/dev/null
}

gpg_key_fingerprint() {
    local email="$1"
    gpg --list-keys --with-colons --fingerprint "${email}" 2>/dev/null \
        | awk -F: '/^fpr:/{print $10; exit}'
}

# =============================================================================
# GPG AGENT CONFIG (FIX H-2: use gpgconf --launch)
# =============================================================================

setup_gpg_agent() {
    print_section "Configuring GPG Agent"

    mkdir -p "${GNUPG_DIR}"
    chmod 700 "${GNUPG_DIR}"

    local agent_conf="${GNUPG_DIR}/gpg-agent.conf"

    # Determine best available pinentry
    local pinentry_prog=""
    for candidate in \
        /usr/bin/pinentry-curses \
        /usr/bin/pinentry-qt \
        /usr/bin/pinentry-gnome3 \
        /usr/bin/pinentry-gtk-2 \
        /usr/bin/pinentry; do
        if [[ -x "${candidate}" ]]; then
            pinentry_prog="${candidate}"
            break
        fi
    done

    cat > "${agent_conf}" <<EOF
# gpg-agent.conf — Generated by github_multi_account_setup.sh v${SCRIPT_VERSION}
default-cache-ttl 28800
max-cache-ttl 86400
EOF

    if [[ -n "${pinentry_prog}" ]]; then
        echo "pinentry-program ${pinentry_prog}" >> "${agent_conf}"
        print_success "GPG agent will use pinentry: ${pinentry_prog}"
    else
        print_warning "No pinentry program found. GPG may prompt on terminal."
    fi

    chmod 600 "${agent_conf}"

    # gpg.conf
    local gpg_conf="${GNUPG_DIR}/gpg.conf"
    if [[ ! -f "${gpg_conf}" ]]; then
        cat > "${gpg_conf}" <<'EOF'
# gpg.conf — Generated by github_multi_account_setup.sh
keyid-format long
with-fingerprint
trust-model direct
EOF
        chmod 600 "${gpg_conf}"
        print_success "GPG config written: ${gpg_conf}"
    fi

    # Restart agent safely via gpgconf
    gpgconf --kill gpg-agent 2>/dev/null || true
    if gpgconf --launch gpg-agent 2>/dev/null; then
        print_success "GPG agent (re)started"
    else
        print_warning "Could not launch GPG agent (it may already be running or managed by systemd)"
    fi
}

# =============================================================================
# GPG KEY GENERATION (FIX C-1: no %no-protection — user sets passphrase)
# =============================================================================

generate_gpg_keys() {
    print_section "Generating GPG Keys (Ed25519 + Cv25519)"

    print_info "One GPG key will be created per GitHub account."
    print_info "You will be asked to set a passphrase for each key interactively."
    print_warning "Please use a strong, memorable passphrase. Do not leave it empty!"
    echo ""

    local generated=0

    for account in configs personal work common; do
        local email="${ACCOUNTS[${account}]}"
        local name="${GIT_NAMES[${account}]}"

        if gpg_key_exists "${email}"; then
            local fp
            fp=$(gpg_key_fingerprint "${email}")
            print_info "GPG key already exists for ${account} (${email})"
            print_info "  Fingerprint: ${fp}"
            continue
        fi

        print_info "Generating GPG key for ${account} (${name} <${email}>)..."
        print_info "Pinentry will prompt for a passphrase. If none appears, use Ctrl+C to abort."

        local batch_input
        batch_input=$(mktemp)
        TEMP_FILES+=("${batch_input}")

        cat > "${batch_input}" <<EOF
Key-Type: eddsa
Key-Curve: Ed25519
Key-Usage: sign,cert
Subkey-Type: ecdh
Subkey-Curve: Curve25519
Subkey-Usage: encrypt
Name-Real: ${name}
Name-Email: ${email}
Expire-Date: 2y
%commit
EOF

        if gpg --batch --gen-key "${batch_input}" 2>/dev/null; then
            local fingerprint
            fingerprint=$(gpg_key_fingerprint "${email}")
            if [[ -n "${fingerprint}" ]]; then
                echo "${fingerprint}:6:" | gpg --import-ownertrust 2>/dev/null
                print_success "Generated GPG key for ${account}: ${fingerprint}"
                ((generated++)) || true
            else
                print_warning "Generated key for ${account} but could not retrieve fingerprint"
            fi
        else
            print_error "Failed to generate GPG key for ${account}"
        fi

        rm -f "${batch_input}"
    done

    if [[ ${generated} -eq 0 ]]; then
        print_info "All GPG keys already exist (or generation was skipped)"
    else
        print_success "Generated ${generated} new GPG key(s)"
    fi
}

backup_gpg_keys() {
    print_section "Backing Up GPG Keys"

    mkdir -p "${GPG_CRYPT_KEY_DIR}"
    chmod 700 "${GPG_CRYPT_KEY_DIR}"

    local backup_file="${GPG_CRYPT_KEY_DIR}/all-secret-keys-$(date +%Y%m%d).asc"
    local trust_file="${GPG_CRYPT_KEY_DIR}/ownertrust-$(date +%Y%m%d).txt"

    if gpg --export-secret-keys --armor --output "${backup_file}" 2>/dev/null; then
        chmod 600 "${backup_file}"
        print_success "Secret keys backed up: ${backup_file}"
    else
        print_warning "Could not export secret keys (no keys present yet?)"
    fi

    if gpg --export-ownertrust > "${trust_file}" 2>/dev/null; then
        chmod 600 "${trust_file}"
        print_success "Owner trust backed up: ${trust_file}"
    fi

    print_warning "Store ${GPG_CRYPT_KEY_DIR} on encrypted offline storage!"
}

# =============================================================================
# GIT-CRYPT INSTALLATION
# =============================================================================

install_git_crypt() {
    print_section "Installing git-crypt"

    if command_exists git-crypt; then
        local ver
        ver=$(git-crypt --version 2>/dev/null || echo "unknown")
        print_success "git-crypt already installed: ${ver}"
        return 0
    fi

    print_info "git-crypt not found. Installing for ${DISTRO}..."

    case "${DISTRO}" in
        arch)
            install_package_arch "git-crypt"
            ;;
        gentoo)
            print_info "Enabling guru overlay for git-crypt..."
            if command_exists eselect; then
                sudo eselect repository enable guru 2>/dev/null || true
                sudo emaint sync -r guru 2>/dev/null || true
                install_package_gentoo "dev-vcs/git-crypt"
            else
                print_warning "eselect not found. Building git-crypt from source..."
                _install_git_crypt_from_source
            fi
            ;;
        *)
            print_warning "Unknown distro. Attempting to build git-crypt from source..."
            _install_git_crypt_from_source
            ;;
    esac

    if command_exists git-crypt; then
        print_success "git-crypt installed successfully"
    else
        print_error "git-crypt installation failed. Please install it manually."
        return 1
    fi
}

_install_git_crypt_from_source() {
    print_info "Building git-crypt from source (latest release)..."

    local build_dir
    build_dir=$(mktemp -d)
    trap 'rm -rf "${build_dir}"' RETURN

    if git clone --depth 1 https://github.com/AGWA/git-crypt.git "${build_dir}" 2>/dev/null; then
        (
            cd "${build_dir}"
            make -j"$(nproc)"
            sudo make install PREFIX=/usr/local
        )
        print_success "git-crypt built and installed to /usr/local/bin"
    else
        print_error "Failed to clone git-crypt repository"
        return 1
    fi
}

# =============================================================================
# ENCRYPTION PER REPOSITORY (FIXES H-3, M-2)
# =============================================================================

create_default_gitattributes() {
    local repo_dir="$1"
    local gitattributes="${repo_dir}/.gitattributes"

    if [[ -f "${gitattributes}" ]]; then
        if grep -q "filter=git-crypt" "${gitattributes}" 2>/dev/null; then
            print_info "  .gitattributes already has git-crypt rules (skipping)"
            return 0
        fi
        print_info "  Appending git-crypt rules to existing .gitattributes"
        cat >> "${gitattributes}" <<'EOF'

# ── git-crypt encrypted files ──────────────────────────────────────────────
# Secrets directory (catch-all for sensitive data)
secrets/**              filter=git-crypt diff=git-crypt
private/**              filter=git-crypt diff=git-crypt

# Environment / configuration files
.env                    filter=git-crypt diff=git-crypt
.env.*                  filter=git-crypt diff=git-crypt
*.env                   filter=git-crypt diff=git-crypt

# Key material
*.key                   filter=git-crypt diff=git-crypt
*.pem                   filter=git-crypt diff=git-crypt
*.p12                   filter=git-crypt diff=git-crypt
*.pfx                   filter=git-crypt diff=git-crypt
*.asc                   filter=git-crypt diff=git-crypt

# Credential / token files
*credentials*           filter=git-crypt diff=git-crypt
*token*                 filter=git-crypt diff=git-crypt
*secret*                filter=git-crypt diff=git-crypt
*password*              filter=git-crypt diff=git-crypt
auth.json               filter=git-crypt diff=git-crypt
service-account.json    filter=git-crypt diff=git-crypt

# Infrastructure secrets
*.tfvars                filter=git-crypt diff=git-crypt
*vault*                 filter=git-crypt diff=git-crypt
*-secret.yaml           filter=git-crypt diff=git-crypt
*-secret.yml            filter=git-crypt diff=git-crypt
EOF
    else
        print_info "  Creating new .gitattributes with git-crypt rules"
        cat > "${gitattributes}" <<'EOF'
# .gitattributes — git-crypt encryption rules
# Files matching these patterns are transparently encrypted on push.
# Generated by github_multi_account_setup.sh

# ── git-crypt encrypted files ──────────────────────────────────────────────
# Secrets directory (catch-all for sensitive data)
secrets/**              filter=git-crypt diff=git-crypt
private/**              filter=git-crypt diff=git-crypt

# Environment / configuration files
.env                    filter=git-crypt diff=git-crypt
.env.*                  filter=git-crypt diff=git-crypt
*.env                   filter=git-crypt diff=git-crypt

# Key material
*.key                   filter=git-crypt diff=git-crypt
*.pem                   filter=git-crypt diff=git-crypt
*.p12                   filter=git-crypt diff=git-crypt
*.pfx                   filter=git-crypt diff=git-crypt
*.asc                   filter=git-crypt diff=git-crypt

# Credential / token files
*credentials*           filter=git-crypt diff=git-crypt
*token*                 filter=git-crypt diff=git-crypt
*secret*                filter=git-crypt diff=git-crypt
*password*              filter=git-crypt diff=git-crypt
auth.json               filter=git-crypt diff=git-crypt
service-account.json    filter=git-crypt diff=git-crypt

# Infrastructure secrets
*.tfvars                filter=git-crypt diff=git-crypt
*vault*                 filter=git-crypt diff=git-crypt
*-secret.yaml           filter=git-crypt diff=git-crypt
*-secret.yml            filter=git-crypt diff=git-crypt
EOF
    fi
}

init_repo_encryption() {
    local repo_dir="$1"
    local gpg_email="$2"
    local account_name="$3"

    local repo_name
    repo_name=$(basename "${repo_dir}")

    echo ""
    echo -e "  ${CYAN}Repository: ${repo_name}${NC}"

    if [[ ! -d "${repo_dir}/.git" ]]; then
        print_info "  Not a git repository — skipping"
        return 0
    fi

    if [[ -d "${repo_dir}/.git/git-crypt" ]]; then
        print_info "  git-crypt already initialized"
        if gpg_key_exists "${gpg_email}"; then
            local fp
            fp=$(gpg_key_fingerprint "${gpg_email}")
            local add_output
            if add_output=$(cd "${repo_dir}" && git-crypt add-gpg-user --trusted "${fp}" 2>&1); then
                print_success "  GPG user added/confirmed: ${gpg_email}"
            else
                if echo "${add_output}" | grep -qi "already.*added\|is already"; then
                    print_info "  GPG user already present"
                else
                    print_warning "  Could not add GPG user: ${add_output}"
                fi
            fi
        fi
    else
        print_info "  Initializing git-crypt..."
        if ( cd "${repo_dir}" && git-crypt init 2>/dev/null ); then
            print_success "  git-crypt initialized"
            if gpg_key_exists "${gpg_email}"; then
                local fp
                fp=$(gpg_key_fingerprint "${gpg_email}")
                if ( cd "${repo_dir}" && git-crypt add-gpg-user --trusted "${fp}" 2>/dev/null ); then
                    print_success "  Added GPG user: ${gpg_email} (${account_name})"
                else
                    print_warning "  Could not add GPG user: ${gpg_email}"
                fi
            else
                print_warning "  GPG key not found for ${gpg_email} — skipping add-gpg-user"
            fi
        else
            print_error "  Failed to initialize git-crypt"
            return 1
        fi
    fi

    # Create/update .gitattributes
    create_default_gitattributes "${repo_dir}"

    # Symmetric key backup
    local key_backup="${GPG_CRYPT_KEY_DIR}/${account_name}-${repo_name}.git-crypt.key"
    if [[ -d "${repo_dir}/.git/git-crypt" ]]; then
        ( cd "${repo_dir}" && git-crypt export-key "${key_backup}" 2>/dev/null ) && {
            chmod 600 "${key_backup}"
            print_success "  Symmetric key backed up: ${key_backup}"
        }
    fi

    # Stage and commit .gitattributes if needed
    (
        cd "${repo_dir}"
        if git status --short .gitattributes 2>/dev/null | grep -q .; then
            git add .gitattributes 2>/dev/null || true
            if git commit -m "chore: add git-crypt encryption rules" 2>/dev/null; then
                print_success "  Committed .gitattributes"
                # FIX H-3: remind about re-encrypting existing files
                print_warning "  Existing files matching encryption patterns are NOT encrypted yet."
                print_info "    To encrypt them run: git add --renormalize .  (or add specific files) and commit"
            else
                print_info "  Nothing to commit for .gitattributes"
            fi
        fi
    )

    return 0
}

# =============================================================================
# REPOSITORY DISCOVERY (FIX M-1: use find -maxdepth 3)
# =============================================================================

encrypt_directory_repos() {
    local base_dir="$1"
    local gpg_email="$2"
    local account_name="$3"

    if [[ ! -d "${base_dir}" ]]; then
        print_info "Directory does not exist — skipping: ${base_dir}"
        return 0
    fi

    print_info "Scanning ${base_dir} for git repositories (up to 3 levels deep)..."

    local repos=()
    while IFS= read -r -d '' gitdir; do
        repos+=("$(dirname "${gitdir}")")
    done < <(find "${base_dir}" -maxdepth 3 -name .git -type d -print0 2>/dev/null || true)

    if [[ ${#repos[@]} -eq 0 ]]; then
        print_info "No git repositories found under ${account_name} directory"
        return 0
    fi

    print_info "Found ${#repos[@]} repository(ies)"
    local count=0
    for repo_dir in "${repos[@]}"; do
        init_repo_encryption "${repo_dir}" "${gpg_email}" "${account_name}"
        ((count++)) || true
    done
    print_success "Processed ${count} repository(ies) for ${account_name}"
}

setup_encryption() {
    print_section "Setting Up Repository Encryption (git-crypt + GPG)"

    echo ""
    print_info "This will:"
    print_info "  1. Install git-crypt (if not present)"
    print_info "  2. Generate GPG keys (Ed25519) — one per account (passphrase protected!)"
    print_info "  3. Configure gpg-agent with 8-hour passphrase cache"
    print_info "  4. Initialize git-crypt in ALL repositories under ~/Git/ (depth 3)"
    print_info "  5. Add the correct GPG key per directory/account"
    print_info "  6. Create default .gitattributes (encrypts .env, *.key, secrets/**, etc.)"
    print_info "  7. Export symmetric backup keys to ${GPG_CRYPT_KEY_DIR}/"
    echo ""

    if ! confirm "Set up repository encryption for all accounts?"; then
        print_info "Encryption setup skipped."
        return 0
    fi

    install_git_crypt
    setup_gpg_agent
    generate_gpg_keys
    backup_gpg_keys

    mkdir -p "${GPG_CRYPT_KEY_DIR}"
    chmod 700 "${GPG_CRYPT_KEY_DIR}"

    print_section "Encrypting Repositories"

    for account in personal work common; do
        if [[ -v GIT_DIRS[${account}] ]]; then
            encrypt_directory_repos \
                "${GIT_DIRS[${account}]}" \
                "${ACCOUNTS[${account}]}" \
                "${account}"
        fi
    done

    print_info "Scanning root-level repos (configs account)..."
    local account_subdirs=()
    for account in personal work common; do
        [[ -v GIT_DIRS[${account}] ]] && account_subdirs+=("$(basename "${GIT_DIRS[${account}]}")")
    done

    for repo in "${GIT_BASE_DIR}"/*/; do
        local dir="${repo%/}"
        local name
        name=$(basename "${dir}")
        local is_account_dir=false
        for subdir in "${account_subdirs[@]}"; do
            [[ "${name}" == "${subdir}" ]] && is_account_dir=true && break
        done
        ${is_account_dir} && continue
        if [[ -d "${dir}/.git" ]]; then
            init_repo_encryption "${dir}" "${ACCOUNTS[configs]}" "configs"
        fi
    done

    echo ""
    print_success "Encryption setup complete!"
    print_info "Symmetric key backups are in: ${GPG_CRYPT_KEY_DIR}/"
    print_warning "Store these keys securely offline. They are the recovery mechanism if GPG keys are lost."
}

# =============================================================================
# VERIFICATION (FIX M-3: use mktemp for test directory)
# =============================================================================

verify_setup() {
    print_section "Verifying Setup"

    local all_good=true

    # Check SSH keys
    print_info "Checking SSH keys..."
    for account in "${!ACCOUNTS[@]}"; do
        local key_file="${SSH_DIR}/id_ed25519_aahsnr_${account}"
        local pub_file="${key_file}.pub"

        if [[ -f "${key_file}" ]] && [[ -f "${pub_file}" ]]; then
            echo -e "  ${GREEN}✓${NC} ${account}: SSH keys exist"
        else
            echo -e "  ${RED}✗${NC} ${account}: SSH keys missing"
            all_good=false
        fi
    done

    # Check GPG keys
    print_info "Checking GPG keys..."
    for account in configs personal work common; do
        local email="${ACCOUNTS[${account}]}"
        if gpg_key_exists "${email}"; then
            local fp
            fp=$(gpg_key_fingerprint "${email}")
            echo -e "  ${GREEN}✓${NC} ${account}: GPG key exists (${fp:0:16}...)"
        else
            echo -e "  ${YELLOW}⚠${NC} ${account}: GPG key missing (run encryption setup)"
        fi
    done

    # Check SSH config
    print_info "Checking SSH config..."
    if [[ -f "${SSH_DIR}/config" ]]; then
        if ssh -G github.com-aahsnr-configs &>/dev/null; then
            print_success "SSH config exists and is valid"
        else
            print_error "SSH config has syntax errors"
            all_good=false
        fi
    else
        print_error "SSH config missing"
        all_good=false
    fi

    # Check Git config
    print_info "Checking Git config..."
    if [[ -f "${GIT_CONFIG}" ]]; then
        if git config --global --list &>/dev/null; then
            print_success "Main Git config exists and is valid"
        else
            print_error "Main Git config has syntax errors"
            all_good=false
        fi
    else
        print_error "Main Git config missing"
        all_good=false
    fi

    # Check directory-specific configs
    for account in personal work common; do
        if [[ -v GIT_DIRS[${account}] ]]; then
            local dir="${GIT_DIRS[${account}]}"
            local dir_config="${dir}/.gitconfig"
            if [[ -f "${dir_config}" ]]; then
                echo -e "  ${GREEN}✓${NC} ${account} Git config exists"
            else
                echo -e "  ${RED}✗${NC} ${account} Git config missing"
                all_good=false
            fi
        fi
    done

    # Test Git conditional includes — using mktemp
    print_info "Testing Git conditional includes..."
    for account in personal work common; do
        if [[ -v GIT_DIRS[${account}] ]]; then
            local dir="${GIT_DIRS[${account}]}"

            if [[ ! -d "${dir}" ]]; then
                print_warning "${dir} doesn't exist; skipping conditional include test"
                continue
            fi

            local test_dir
            test_dir=$(mktemp -d --tmpdir="${dir}" ".git_test_XXXXXX" 2>/dev/null)
            if [[ -z "${test_dir}" ]]; then
                print_warning "Could not create test directory in ${dir}"
                continue
            fi
            # Cleanup test_dir on return/exit
            trap "rm -rf '${test_dir}'" RETURN

            if git -C "${test_dir}" init &>/dev/null; then
                local detected_email
                detected_email=$(git -C "${test_dir}" config user.email 2>/dev/null || echo "")

                if [[ "${detected_email}" == "${ACCOUNTS[${account}]}" ]]; then
                    echo -e "  ${GREEN}✓${NC} ${account} directory correctly configured (${detected_email})"
                else
                    echo -e "  ${RED}✗${NC} ${account} directory not properly configured"
                    echo -e "     Expected: ${ACCOUNTS[${account}]}, Got: ${detected_email:-<empty>}"
                    all_good=false
                fi
            else
                print_warning "Could not init test repo in ${test_dir}"
            fi
            rm -rf "${test_dir}"
        fi
    done

    # Check git-crypt
    print_info "Checking git-crypt..."
    if command_exists git-crypt; then
        local ver
        ver=$(git-crypt --version 2>/dev/null || echo "unknown")
        print_success "git-crypt available: ${ver}"
    else
        echo -e "  ${YELLOW}⚠${NC} git-crypt not installed (run encryption setup)"
    fi

    echo ""
    if ${all_good}; then
        print_success "All checks passed! ✨"
    else
        print_warning "Some checks failed. Please review the output above."
        return 1
    fi
}

# =============================================================================
# DISPLAY PUBLIC KEYS
# =============================================================================

display_public_keys() {
    print_section "Public Keys for GitHub"

    echo "Copy these public keys to your respective GitHub accounts:"
    echo ""
    echo "GitHub Settings → SSH and GPG keys → New SSH key"
    echo ""

    for account in configs personal work common; do
        if [[ -v ACCOUNTS[${account}] ]]; then
            local pub_file="${SSH_DIR}/id_ed25519_aahsnr_${account}.pub"

            if [[ -f "${pub_file}" ]]; then
                echo -e "${BOLD}${CYAN}╭─ Account: ${GIT_NAMES[${account}]} (${ACCOUNTS[${account}]})${NC}"
                echo -e "${YELLOW}│${NC}"

                local pubkey
                pubkey=$(cat "${pub_file}")
                echo -e "${YELLOW}│${NC} ${pubkey}"

                local fingerprint
                fingerprint=$(ssh-keygen -lf "${pub_file}" 2>/dev/null | awk '{print $2}')
                echo -e "${YELLOW}│${NC}"
                echo -e "${YELLOW}│${NC} SSH Fingerprint: ${fingerprint}"

                if gpg_key_exists "${ACCOUNTS[${account}]}"; then
                    local gpg_fp
                    gpg_fp=$(gpg_key_fingerprint "${ACCOUNTS[${account}]}")
                    echo -e "${YELLOW}│${NC} GPG Fingerprint: ${gpg_fp}"
                fi

                echo -e "${YELLOW}╰───────────────────────────────────────────────────────────────${NC}"
                echo ""
            fi
        fi
    done

    echo ""
    echo "For GPG keys (GitHub Settings → SSH and GPG keys → New GPG key):"
    echo ""
    for account in configs personal work common; do
        local email="${ACCOUNTS[${account}]}"
        if gpg_key_exists "${email}"; then
            echo -e "${BOLD}${CYAN}GPG public key for ${account} (${email}):${NC}"
            gpg --armor --export "${email}" 2>/dev/null
            echo ""
        fi
    done
}

