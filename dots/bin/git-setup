display_instructions() {
    print_section "Next Steps"

    printf "${BOLD}1. Add SSH Keys to GitHub${NC}\n\n"
    printf "   For each account, go to: ${CYAN}https://github.com/settings/keys${NC}\n\n"
    printf "   a) Click \"New SSH key\"\n"
    printf "   b) Give it a meaningful title (e.g., \"Arch - Ed25519 - 2025\")\n"
    printf "   c) Select \"Authentication Key\" as the key type\n"
    printf "   d) Paste the public key shown above\n"
    printf "   e) Click \"Add SSH key\"\n\n"

    printf "${BOLD}2. (Optional) Add GPG Keys to GitHub${NC}\n\n"
    printf "   If you want signed commits visible on GitHub:\n"
    printf "   GitHub Settings → SSH and GPG keys → New GPG key\n"
    printf "   Paste the GPG public key shown above.\n\n"

    printf "${BOLD}3. Test SSH Connections${NC}\n\n"
    for account in configs personal work common; do
        if [[ -v ACCOUNTS[${account}] ]]; then
            printf "   ${CYAN}ssh -T git@github.com-aahsnr-${account}${NC}  # Test ${account}\n"
        fi
    done
    printf "\n   Expected: \"Hi username! You've successfully authenticated...\"\n\n"

    printf "${BOLD}4. Clone Repositories${NC}\n\n"
    printf "   ${GREEN}personal${NC} (in ~/Git/personal/):\n"
    printf "   ${CYAN}cd ~/Git/personal && git clone git@github.com-aahsnr-personal:aahsnr/repo.git${NC}\n\n"
    printf "   ${GREEN}work${NC} (in ~/Git/work/):\n"
    printf "   ${CYAN}cd ~/Git/work && git clone git@github.com-aahsnr-work:aahsnr/repo.git${NC}\n\n"
    printf "   ${GREEN}common${NC} (in ~/Git/common/):\n"
    printf "   ${CYAN}cd ~/Git/common && git clone git@github.com-aahsnr-common:aahsnr/repo.git${NC}\n\n"

    printf "${BOLD}5. Unlock Encrypted Repositories After Cloning${NC}\n\n"
    printf "   ${CYAN}cd ~/Git/personal/my-encrypted-repo${NC}\n"
    printf "   ${CYAN}git-crypt unlock${NC}\n\n"
    printf "   GPG will prompt for your passphrase via pinentry.\n"
    printf "   After unlock, all git operations work transparently.\n\n"

    printf "${BOLD}6. Add New Encrypted Files${NC}\n\n"
    printf "   ${CYAN}cd ~/Git/personal/my-repo${NC}\n"
    printf "   ${CYAN}echo 'API_KEY=secret' > .env${NC}\n"
    printf "   ${CYAN}git add .env && git commit -m 'add encrypted env file'${NC}\n"
    printf "   ${CYAN}git push  # .env is encrypted on GitHub, plaintext locally${NC}\n\n"

    printf "${BOLD}7. Directory Structure and Auto-Switching${NC}\n\n"
    printf "   ${HOME}/Git/\n"
    printf "   ├── personal/  ${GREEN}→ personal account + GPG key (ahsanur041@gmail.com)${NC}\n"
    printf "   ├── work/      ${GREEN}→ work account + GPG key (aahsnr041@proton.me)${NC}\n"
    printf "   ├── common/    ${GREEN}→ common account + GPG key (ahsan.05rahman@gmail.com)${NC}\n"
    printf "   └── other/     ${GREEN}→ configs account + GPG key (ahsanur041@proton.me)${NC}\n\n"

    printf "${BOLD}8. Symmetric Key Backups${NC}\n\n"
    printf "   Per-repo symmetric keys are in: ${CYAN}${GPG_CRYPT_KEY_DIR}/${NC}\n"
    printf "   GPG secret key backup is also in that directory.\n"
    printf "   Store this directory on encrypted offline storage (USB/LUKS).\n\n"

    printf "${BOLD}Backup Information:${NC}\n\n"
    printf "   All previous configurations were backed up to:\n"
    printf "   ${CYAN}${BACKUP_DIR}${NC}\n\n"

    printf "${BOLD}Pro Tips:${NC}\n\n"
    printf "   • Always clone repos into the correct directory for auto identity switching\n"
    printf "   • Use ${CYAN}git-crypt status${NC} to verify which files are encrypted\n"
    printf "   • Use ${CYAN}git-crypt lock${NC} to re-encrypt your working copy when stepping away\n"
    printf "   • Ed25519 GPG and SSH keys are more secure and faster than RSA\n"
    printf "   • Files named in .gitattributes are encrypted on GitHub but plaintext locally\n\n"

    print_success "Setup complete! Happy coding! 🚀"
}

# =============================================================================
# MAIN FUNCTION
# =============================================================================

main() {
    print_header

    check_dependencies

    echo ""
    print_info "This script will CLEAN UP managed configurations and set up"
    print_info "SSH keys, GPG keys, Git config, git-crypt encryption, and GitHub CLI"
    print_info "for multiple GitHub accounts."
    print_info "Non‑managed SSH keys will be left untouched."
    echo ""
    print_info "Detected distribution: ${BOLD}${DISTRO}${NC}"
    echo ""

    # Comprehensive cleanup (scoped)
    cleanup_all_configs

    # Generate SSH keys
    generate_ssh_keys

    # Configure SSH
    configure_ssh

    # Configure Git
    configure_git

    # Setup SSH agent (only if agent is running)
    setup_ssh_agent

    # Configure GitHub CLI
    configure_github_cli

    # Setup encryption (interactive — user can skip)
    setup_encryption

    # Verify everything
    if verify_setup; then
        display_public_keys
        display_instructions
    else
        print_error "Setup verification failed. Please check the errors above."
        exit 1
    fi
}

# =============================================================================
# SCRIPT ENTRY POINT
# =============================================================================

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
