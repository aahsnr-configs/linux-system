#!/usr/bin/env bash
#
# copr-silverblue - Enable/disable COPR repositories for Fedora immutable distros
#
# Usage: copr-silverblue <enable|disable|remove|list|search> <author/reponame> [fedora-version]
#
# This script converts the standard 'dnf copr' command to work with
# Fedora Silverblue, Kinoite, and other immutable Fedora distributions that
# use rpm-ostree instead of dnf.
#
# Author: Community script for Fedora Atomic/Immutable distributions
# License: GPL-3.0

set -euo pipefail

# Constants
readonly SCRIPT_VERSION="2.0"
readonly COPR_BASE_URL="https://copr.fedorainfracloud.org/coprs"
readonly REPO_DIR="/etc/yum.repos.d"
readonly BACKUP_DIR="${HOME}/.local/share/copr-backups"

# Color codes for output (only use if terminal supports it)
if [[ -t 1 ]]; then
    readonly RED='\033[0;31m'
    readonly GREEN='\033[0;32m'
    readonly YELLOW='\033[1;33m'
    readonly BLUE='\033[0;34m'
    readonly NC='\033[0m'
else
    readonly RED=''
    readonly GREEN=''
    readonly YELLOW=''
    readonly BLUE=''
    readonly NC=''
fi

# COPR warning message (from official dnf copr plugin)
readonly COPR_WARNING="Enabling a Copr repository. Please note that this repository is not part
of the main distribution, and quality may vary.

The Fedora Project does not exercise any power over the contents of
this repository beyond the rules outlined in the Copr FAQ at
<https://docs.pagure.org/copr.copr/user_documentation.html#what-i-can-build-in-copr>,
and packages are not held to any quality or security level.

Please do not file bug reports about these packages in Fedora
Bugzilla. In case of problems, contact the owner of this repository."

# Helper functions
print_error() {
    echo -e "${RED}Error: $*${NC}" >&2
}

print_success() {
    echo -e "${GREEN}✓ $*${NC}"
}

print_warning() {
    echo -e "${YELLOW}Warning: $*${NC}"
}

print_info() {
    echo -e "${BLUE}→ $*${NC}"
}

# Function to display usage information
usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [arguments]

Commands:
    enable <author/reponame> [version]    Enable a COPR repository
    disable <author/reponame>             Disable a COPR repository
    remove <author/reponame>              Remove a COPR repository
    list                                  List all enabled COPR repositories
    search <query>                        Search for COPR repositories (opens browser)
    help                                  Display this help message

Arguments:
    author/reponame     COPR repository in format: author/reponame
    version             (Optional) Fedora version number (auto-detected if not provided)
    query               Search term for finding COPR repositories

Examples:
    $(basename "$0") enable avengemedia/dms
    $(basename "$0") enable avengemedia/dms 40
    $(basename "$0") disable avengemedia/dms
    $(basename "$0") remove avengemedia/dms
    $(basename "$0") list
    $(basename "$0") search video-editor

After enabling a repository:
    1. Refresh metadata: rpm-ostree refresh-md
    2. Install packages:  rpm-ostree install <package-name>
    3. Reboot to apply:   systemctl reboot

Version: $SCRIPT_VERSION

EOF
    exit 0
}

# Function to check if we're on an immutable Fedora distribution
check_immutable_system() {
    if ! command -v rpm-ostree &>/dev/null; then
        print_warning "rpm-ostree not found. This script is designed for Fedora immutable distributions."
        print_warning "For regular Fedora, use: sudo dnf copr enable <author/reponame>"
        read -rp "Continue anyway? (y/N): " response
        [[ "$response" =~ ^[Yy]$ ]] || exit 1
    fi
}

# Function to get privilege escalation command (run0 or sudo)
get_priv_cmd() {
    if command -v run0 &>/dev/null; then
        echo "run0"
    elif command -v sudo &>/dev/null; then
        echo "sudo"
    else
        print_error "Neither 'run0' nor 'sudo' found. Cannot escalate privileges."
        exit 1
    fi
}

# Function to validate COPR repository format
validate_copr_repo() {
    local repo="$1"

    if [[ ! "$repo" =~ ^[a-zA-Z0-9_-]+/[a-zA-Z0-9_-]+$ ]]; then
        print_error "Invalid COPR repository format: $repo"
        print_error "Expected format: author/reponame (e.g., avengemedia/dms)"
        return 1
    fi

    return 0
}

# Function to detect Fedora version
detect_fedora_version() {
    local version

    # Try rpm -E first
    if command -v rpm &>/dev/null; then
        version=$(rpm -E '%{fedora}' 2>/dev/null)
        if [[ "$version" =~ ^[0-9]+$ ]]; then
            echo "$version"
            return 0
        fi
    fi

    # Fallback to /etc/os-release
    if [[ -f /etc/os-release ]]; then
        # shellcheck disable=SC1091
        source /etc/os-release
        if [[ -n "${VERSION_ID:-}" ]] && [[ "${VERSION_ID}" =~ ^[0-9]+$ ]]; then
            echo "$VERSION_ID"
            return 0
        fi
    fi

    print_error "Could not detect Fedora version"
    return 1
}

# Function to parse COPR repository
parse_copr_repo() {
    local repo="$1"
    echo "$repo" | tr '/' ' '
}

# Function to get repo filename
get_repo_filename() {
    local author="$1"
    local reponame="$2"

    # Use the simpler naming format: _copr_author-reponame.repo
    echo "${REPO_DIR}/_copr_${author}-${reponame}.repo"
}

# Function to secure repository files
secure_repo_files() {
    local priv_cmd
    priv_cmd=$(get_priv_cmd)

    print_info "Securing repository files with proper permissions and SELinux context..."

    if ! $priv_cmd sh -c "
        chown root:root \"${REPO_DIR}\"/*.repo 2>/dev/null || true &&
        chmod 644 \"${REPO_DIR}\"/*.repo 2>/dev/null || true &&
        command -v chcon &>/dev/null && chcon -R system_u:object_r:system_conf_t:s0 \"${REPO_DIR}\" 2>/dev/null || true
    "; then
        print_warning "Failed to fully secure repository files (this is usually not critical)"
    fi
}

# Function to enable COPR repository
enable_copr() {
    local author="$1"
    local reponame="$2"
    local version="$3"
    local repo_url="${COPR_BASE_URL}/${author}/${reponame}/repo/fedora-${version}/${author}-${reponame}-fedora-${version}.repo"
    local repo_file
    repo_file=$(get_repo_filename "$author" "$reponame")
    local priv_cmd
    priv_cmd=$(get_priv_cmd)

    print_info "Enabling COPR: ${author}/${reponame} for Fedora ${version}"
    echo ""
    echo "$COPR_WARNING"
    echo ""
    read -rp "Do you really want to enable copr.fedorainfracloud.org/${author}/${reponame}? [y/N]: " response

    if [[ ! "$response" =~ ^[Yy]$ ]]; then
        print_info "Operation cancelled by user"
        return 0
    fi

    # Check if repository file already exists
    if [[ -f "$repo_file" ]]; then
        print_info "Repository file already exists: $repo_file"
        print_info "Enabling repository..."

        if $priv_cmd sed -i 's/enabled=0/enabled=1/g' "$repo_file"; then
            print_success "Repository ${author}/${reponame} enabled"
        else
            print_error "Failed to enable repository"
            return 1
        fi
    else
        # Download repository file
        print_info "Downloading repository configuration..."
        print_info "URL: ${repo_url}"

        if ! curl -fsSL "$repo_url" 2>/dev/null | $priv_cmd tee "$repo_file" >/dev/null; then
            print_error "Failed to download repository file"
            print_error "The repository may not exist or may not support Fedora ${version}"
            print_info "Check: ${COPR_BASE_URL}/${author}/${reponame}/"
            return 1
        fi

        print_success "Repository file installed: $repo_file"
        secure_repo_files
    fi

    # Refresh rpm-ostree metadata
    if command -v rpm-ostree &>/dev/null; then
        print_info "Refreshing rpm-ostree metadata..."
        if $priv_cmd rpm-ostree refresh-md 2>&1 | grep -q "error:"; then
            print_warning "Failed to refresh metadata (you may need to run: $priv_cmd rpm-ostree refresh-md)"
        else
            print_success "Metadata refreshed"
        fi
    fi

    echo ""
    print_success "COPR repository '${author}/${reponame}' enabled successfully!"
    echo ""
    print_info "Next steps:"
    print_info "  1. Install packages: rpm-ostree install <package-name>"
    print_info "  2. Reboot to apply:  systemctl reboot"
}

# Function to disable COPR repository
disable_copr() {
    local author="$1"
    local reponame="$2"
    local repo_file
    repo_file=$(get_repo_filename "$author" "$reponame")
    local priv_cmd
    priv_cmd=$(get_priv_cmd)

    print_info "Disabling COPR: ${author}/${reponame}"

    # Check if repository file exists
    if [[ ! -f "$repo_file" ]]; then
        print_error "Repository file not found: $repo_file"
        print_error "Repository may not be installed"
        return 1
    fi

    # Disable repository by setting enabled=0
    if $priv_cmd sed -i 's/enabled=1/enabled=0/g' "$repo_file"; then
        print_success "Repository ${author}/${reponame} disabled"
        print_info "The repository file is kept but disabled"
        print_info "To re-enable: $(basename "$0") enable ${author}/${reponame}"
        print_info "To remove completely: $(basename "$0") remove ${author}/${reponame}"
    else
        print_error "Failed to disable repository"
        return 1
    fi
}

# Function to remove COPR repository
remove_copr() {
    local author="$1"
    local reponame="$2"
    local repo_file
    repo_file=$(get_repo_filename "$author" "$reponame")
    local priv_cmd
    priv_cmd=$(get_priv_cmd)

    print_info "Removing COPR: ${author}/${reponame}"

    # Check if repository file exists
    if [[ ! -f "$repo_file" ]]; then
        # Try to find the repo file by searching
        print_warning "Repository file not found: $repo_file"
        print_info "Searching for repository..."

        local found_file
        found_file=$(find "$REPO_DIR" -type f -name "*${reponame}*" -name "*.repo" | head -n 1)

        if [[ -z "$found_file" ]]; then
            print_error "No repository containing '${reponame}' found"
            return 1
        fi

        print_info "Found repository file: $found_file"
        read -rp "Remove this repository? [y/N]: " response

        if [[ ! "$response" =~ ^[Yy]$ ]]; then
            print_info "Operation cancelled"
            return 0
        fi

        repo_file="$found_file"
    fi

    # Create backup directory if needed
    mkdir -p "$BACKUP_DIR"

    # Backup and remove
    local backup_file="${BACKUP_DIR}/$(basename "$repo_file").$(date +%Y%m%d-%H%M%S)"

    if $priv_cmd cp "$repo_file" "$backup_file" 2>/dev/null; then
        $priv_cmd chown "$USER:$USER" "$backup_file" 2>/dev/null || true
        print_info "Backup saved: $backup_file"
    fi

    if $priv_cmd rm "$repo_file"; then
        print_success "Repository ${author}/${reponame} removed"
        print_info "Packages from this repository will remain installed"
        print_info "To remove packages: rpm-ostree uninstall <package-name>"
    else
        print_error "Failed to remove repository file"
        return 1
    fi
}

# Function to list COPR repositories
list_copr() {
    print_info "Installed COPR repositories:"
    echo ""

    local found=0
    while IFS= read -r -d '' file; do
        local basename
        basename=$(basename "$file")
        # Remove _copr_ prefix and .repo suffix
        local reponame="${basename#_copr_}"
        reponame="${reponame%.repo}"

        # Check if enabled
        local status="disabled"
        if grep -q "enabled=1" "$file" 2>/dev/null; then
            status="enabled"
        fi

        # Format: author-reponame -> author/reponame
        local formatted
        formatted=$(echo "$reponame" | sed 's/-/\//')

        if [[ "$status" == "enabled" ]]; then
            echo -e "  ${GREEN}●${NC} $formatted (enabled)"
        else
            echo -e "  ${RED}○${NC} $formatted (disabled)"
        fi
        found=1
    done < <(find "$REPO_DIR" -type f -name "_copr_*.repo" -print0 2>/dev/null)

    if [[ $found -eq 0 ]]; then
        echo "  No COPR repositories found"
    fi
    echo ""
}

# Function to search COPR repositories
search_copr() {
    local query="$1"
    local search_url="${COPR_BASE_URL}/fulltext/?fulltext=${query}"

    print_info "Opening browser to search for: $query"
    print_info "URL: $search_url"

    if command -v xdg-open &>/dev/null; then
        xdg-open "$search_url" 2>/dev/null &
    elif command -v open &>/dev/null; then
        open "$search_url" 2>/dev/null &
    else
        print_error "Could not open browser automatically"
        print_info "Please visit: $search_url"
    fi
}

# Main function
main() {
    # Check minimum requirements
    if ! command -v curl &>/dev/null; then
        print_error "Required command not found: curl"
        exit 1
    fi

    # Check for help or no arguments
    if [[ $# -eq 0 ]] || [[ "${1:-}" =~ ^(-h|--help|help)$ ]]; then
        usage
    fi

    local command="$1"
    shift || true

    case "$command" in
    enable)
        check_immutable_system

        if [[ $# -lt 1 ]] || [[ $# -gt 2 ]]; then
            print_error "Invalid number of arguments for 'enable'"
            echo "Usage: $(basename "$0") enable <author/reponame> [fedora-version]"
            exit 1
        fi

        local copr_repo="$1"
        local version="${2:-}"

        validate_copr_repo "$copr_repo" || exit 1

        read -r author reponame <<<"$(parse_copr_repo "$copr_repo")"

        if [[ -z "$version" ]]; then
            print_info "Detecting Fedora version..."
            version=$(detect_fedora_version) || exit 1
            print_info "Detected Fedora version: $version"
        elif [[ ! "$version" =~ ^[0-9]+$ ]]; then
            print_error "Invalid Fedora version: $version (must be a number)"
            exit 1
        fi

        enable_copr "$author" "$reponame" "$version"
        ;;

    disable)
        check_immutable_system

        if [[ $# -ne 1 ]]; then
            print_error "Invalid number of arguments for 'disable'"
            echo "Usage: $(basename "$0") disable <author/reponame>"
            exit 1
        fi

        local copr_repo="$1"
        validate_copr_repo "$copr_repo" || exit 1

        read -r author reponame <<<"$(parse_copr_repo "$copr_repo")"
        disable_copr "$author" "$reponame"
        ;;

    remove)
        check_immutable_system

        if [[ $# -ne 1 ]]; then
            print_error "Invalid number of arguments for 'remove'"
            echo "Usage: $(basename "$0") remove <author/reponame>"
            exit 1
        fi

        local copr_repo="$1"
        validate_copr_repo "$copr_repo" || exit 1

        read -r author reponame <<<"$(parse_copr_repo "$copr_repo")"
        remove_copr "$author" "$reponame"
        ;;

    list)
        list_copr
        ;;

    search)
        if [[ $# -ne 1 ]]; then
            print_error "Invalid number of arguments for 'search'"
            echo "Usage: $(basename "$0") search <query>"
            exit 1
        fi

        search_copr "$1"
        ;;

    *)
        print_error "Unknown command: $command"
        echo "Run '$(basename "$0") help' for usage information"
        exit 1
        ;;
    esac
}

# Run main function
main "$@"
