#!/usr/bin/env python3
"""
hyprland_scrolling_first_window.py
───────────────────────────────────────────────────────────────────────────────
Hyprland v0.54.2 scrolling layout — first-window left-alignment manager.
Requires the patched Hyprland build that adds `layoutmsg lockcameraoffset`.

BEHAVIOUR
─────────
  • fullscreen_on_one_column = false at all times.

  • Camera locked at offset 0 while columns don't fill the screen:
        count * column_width < 1.0  →  lockcameraoffset 0
    With column_width = 0.40:
        0 windows → locked  (pre-locks before first window, instant left)
        1 window  → locked  (0.40W, left-aligned)
        2 windows → locked  (0.80W, left-aligned)

  • When a new window causes columns to exceed screen width, the camera is
    snapped so the new window is flush at the right edge of the workarea,
    then the lock is released for normal scrolling.

    The overflow is computed directly from the new window's actual screen
    position (at[0] + size[0]) versus the right edge of the workarea:

        workarea_right = first_win.at[0] + first_win.size[0] / col_w
        overflow_px    = new_win.at[0] + new_win.size[0] - workarea_right

    This avoids any dependency on hyprctl -j monitors, monitor scale, or
    reserved areas. It uses only the actual rendered positions from
    hyprctl -j clients, which are already in logical screen pixels.

WHY THE SNAP IS NEEDED
───────────────────────
When the Nth window opens with the lock at 0, newTarget() calls recalculate().
focusOnInput then calls fitCol(colN) which correctly computes m_offset to show
the new column, but recalculate() is called again immediately after, and
calculateCameraOffset() sees m_lockedOffset = 0 and overrides m_offset back to
0. The new window lands partially off-screen.

Dispatch sequence for the snap:
  lockcameraoffset <overflow_px>
    → setLockedOffset(overflow_px) + recalculate()
    → calculateCameraOffset: lock guard returns overflow_px → m_offset = overflow_px
    → new window flush at right edge                                             ✓
  lockcameraoffset none
    → setLockedOffset(nullopt) + recalculate()
    → centering guard: maxExtent (≥W) >= usablePrimary (W) → guard false
    → m_offset stays at overflow_px                                              ✓
    → normal scrolling resumes                                                   ✓

SETUP
─────
~/.config/hypr/hyprland.conf:
    scrolling {
        fullscreen_on_one_column = false
        column_width             = 0.40
        # ... rest of your scrolling config
    }
    exec-once = python3 /path/to/hyprland_scrolling_first_window.py

Requires Python 3.10+ — no pip packages needed.
"""

from __future__ import annotations

import json
import logging
import os
import socket
import subprocess
import sys
import time
from typing import Optional

# ── Logging ──────────────────────────────────────────────────────────────────

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s  %(levelname)-8s  %(message)s",
    datefmt="%H:%M:%S",
    stream=sys.stdout,
)
log = logging.getLogger("hypr-scroll-fw")


# ── IPC helpers ──────────────────────────────────────────────────────────────

def _run(*args: str, timeout: int = 3) -> str:
    """Run hyprctl and return stdout, empty string on any error."""
    try:
        r = subprocess.run(
            ["hyprctl", *args],
            capture_output=True, text=True, timeout=timeout,
        )
        return r.stdout.strip()
    except Exception as exc:
        log.debug("hyprctl %s failed: %s", args, exc)
        return ""


def _json(*args: str) -> object:
    """Run hyprctl and return parsed JSON, or None on failure."""
    raw = _run(*args)
    if not raw:
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        log.debug("JSON parse error for hyprctl %s: %s", args, exc)
        return None


def layoutmsg(msg: str) -> None:
    """hyprctl dispatch layoutmsg <msg> — targets the active workspace."""
    result = _run("dispatch", "layoutmsg", msg)
    log.debug("layoutmsg %r → %r", msg, result)


def keyword(key: str, value: str) -> None:
    """hyprctl keyword <key> <value> — live config override."""
    _run("keyword", key, value)


def getoption_float(option: str) -> Optional[float]:
    """
    Read a float config option.
    Verified format: {"option": "...", "float": 0.400000, "set": true}
    """
    data = _json("-j", "getoption", option)
    if isinstance(data, dict) and "float" in data:
        return float(data["float"])
    return None


# ── Queries ──────────────────────────────────────────────────────────────────

def socket2_path() -> str:
    """Return the path to Hyprland's socket2 event socket."""
    his = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if not his:
        raise RuntimeError("HYPRLAND_INSTANCE_SIGNATURE is not set.")
    xdg = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return f"{xdg}/hypr/{his}/.socket2.sock"


def get_active_workspace() -> Optional[dict]:
    """
    Return the active workspace dict, or None on failure.
    Verified fields: id (int), name (str), tiledLayout (str).
    """
    data = _json("-j", "activeworkspace")
    if isinstance(data, dict):
        return data
    return None


def get_clients() -> list:
    """Return the full clients list, or empty list on failure."""
    data = _json("-j", "clients")
    return data if isinstance(data, list) else []


def normalise_address(addr: str) -> str:
    """
    Normalise a window address to lowercase without the '0x' prefix for
    consistent comparison between openwindow payload and hyprctl clients.

    Clients: "0x558f844484c0"
    Payload: may or may not include the "0x" prefix depending on Hyprland
             version — normalise both to the bare hex string.
    """
    return addr.lower().removeprefix("0x")


def find_client_by_address(address: str, clients: list) -> Optional[dict]:
    """Find a client dict by its window address (format-tolerant)."""
    needle = normalise_address(address)
    for c in clients:
        if normalise_address(c.get("address", "")) == needle:
            return c
    return None


def tiled_windows(workspace_id: int, clients: list) -> list:
    """
    Return all non-floating, non-hidden, mapped tiled windows on a workspace,
    sorted by their x position (left to right).

    Verified client fields: workspace.id (int), floating (bool), hidden (bool),
    mapped (bool), at (list[int]).
    """
    wins = [
        c for c in clients
        if c.get("workspace", {}).get("id") == workspace_id
        and not c.get("floating", False)
        and not c.get("hidden", False)
        and c.get("mapped", True)
    ]
    wins.sort(key=lambda c: c.get("at", [0])[0])
    return wins


def is_scrolling_workspace(ws: dict) -> bool:
    """
    Return True only for a regular (non-special) workspace using the scrolling
    tiled layout.

    Verified from hyprland_info.txt: workspace 4 uses "dwindle". Special
    workspaces have negative IDs and a "special:" name prefix.
    """
    ws_id   = ws.get("id", -1)
    ws_name = ws.get("name", "")
    layout  = ws.get("tiledLayout", "")
    return ws_id > 0 and not ws_name.startswith("special:") and layout == "scrolling"


def column_width() -> float:
    """Read scrolling:column_width; fall back to 0.40 (user's configured value)."""
    w = getoption_float("scrolling:column_width")
    return w if (w is not None and w > 0) else 0.40


# ── Camera actions ────────────────────────────────────────────────────────────

def lock_at_left() -> None:
    """
    Pin the camera tape at offset 0 via the patched lockcameraoffset layoutmsg.
    Every column is placed from x = workspaceOffset.x, left-aligned.
    """
    log.info("  → lockcameraoffset 0")
    layoutmsg("lockcameraoffset 0")


def unlock_camera() -> None:
    """
    Release the camera lock.  Only called when columns fill or exceed the
    screen width, so the centering guard in calculateCameraOffset() will not
    fire and m_offset is preserved at its current value.
    """
    log.info("  → lockcameraoffset none")
    layoutmsg("lockcameraoffset none")


def snap_right_then_unlock(new_win: dict, first_win: dict, col_w: float) -> bool:
    """
    Snap the camera so the newly opened window is flush at the right edge of
    the workarea, then release the lock for normal scrolling.

    Uses the actual rendered screen positions from hyprctl -j clients:

        workarea_right  = first_win.at[0] + first_win.size[0] / col_w
        overflow_px     = new_win.at[0] + new_win.size[0] - workarea_right

    This is equivalent to computing W*(N*col_w − 1) in tape space, but derived
    entirely from real screen coordinates — no hyprctl -j monitors, no reserved
    area arithmetic, no scale calculations.

    Returns True if the snap was dispatched, False if data is invalid (caller
    should fall back to plain unlock_camera()).
    """
    try:
        new_at_x   = new_win.get("at",   [0, 0])[0]
        new_size_x = new_win.get("size", [0, 0])[0]
        f_at_x     = first_win.get("at",   [0, 0])[0]
        f_size_x   = first_win.get("size", [0, 0])[0]
    except (IndexError, TypeError) as exc:
        log.warning("snap_right_then_unlock: bad client geometry: %s", exc)
        return False

    if f_size_x <= 0 or col_w <= 0:
        log.warning(
            "snap_right_then_unlock: invalid values f_size_x=%d col_w=%.4f",
            f_size_x, col_w,
        )
        return False

    # Right edge of the workarea in screen coords, derived from the first
    # window which is always flush at the left with camera=0.
    workarea_right = f_at_x + f_size_x / col_w

    # How many logical pixels the new window extends past the right edge.
    overflow_px = (new_at_x + new_size_x) - workarea_right

    log.info(
        "  snap: new_win right=%.1f workarea_right=%.1f overflow=%.1fpx",
        new_at_x + new_size_x, workarea_right, overflow_px,
    )

    if overflow_px < 1.0:
        # New window is already fully in view — just unlock.
        log.info("  overflow < 1px, skipping snap → unlock only")
        unlock_camera()
        return True

    px = round(overflow_px)
    log.info("  → lockcameraoffset %d + lockcameraoffset none", px)
    layoutmsg(f"lockcameraoffset {px}")
    layoutmsg("lockcameraoffset none")
    return True


# ── Core sync ─────────────────────────────────────────────────────────────────

def sync_active_workspace(new_win_address: Optional[str] = None) -> None:
    """
    Query the active workspace and apply the correct camera state.

    new_win_address — the address of a window that just opened (from the
        openwindow event payload). When provided and the window count is at
        the locked→unlocked threshold crossing, the camera is snapped to show
        the new window flush at the right edge before unlocking.
        Pass None for all other callers (workspace switch, close, reload, startup).

    Decision rule (col_w = 0.40):
        count * col_w < 1.0   →  lock at 0     (0, 1, 2 windows)
        count * col_w >= 1.0  →  snap+unlock   (threshold crossing, if new_win_address)
                               or plain unlock  (all other cases)

    No-op if the active workspace is not a regular scrolling-layout workspace.
    """
    ws = get_active_workspace()
    if ws is None:
        log.debug("sync: could not get active workspace")
        return

    if not is_scrolling_workspace(ws):
        log.debug(
            "sync: ws '%s' (id=%d, layout=%r) — not scrolling, skipping",
            ws.get("name"), ws.get("id"), ws.get("tiledLayout"),
        )
        return

    ws_id   = ws["id"]
    ws_name = ws["name"]
    col_w   = column_width()

    # Fetch clients once; pass to all helpers to avoid repeated hyprctl calls.
    clients = get_clients()
    wins    = tiled_windows(ws_id, clients)
    count   = len(wins)
    frac    = count * col_w

    log.info(
        "sync ws '%s' (id=%d) — %d window(s), %.2f*%.2f=%.2f",
        ws_name, ws_id, count, count, col_w, frac,
    )

    if frac < 1.0:
        lock_at_left()
        return

    # Columns fill or exceed the screen. Determine if we're at the exact
    # locked→unlocked threshold crossing (previous count was in locked state).
    prev_frac      = (count - 1) * col_w
    at_threshold   = new_win_address is not None and prev_frac < 1.0

    if not at_threshold:
        unlock_camera()
        return

    # Find the new window and the leftmost existing window for the snap.
    new_win = find_client_by_address(new_win_address, clients)

    if new_win is None:
        # Window not yet in clients list — retry once after a short sleep.
        log.debug("snap: new window %r not found in clients, retrying", new_win_address)
        time.sleep(0.03)
        clients = get_clients()
        wins    = tiled_windows(ws_id, clients)
        new_win = find_client_by_address(new_win_address, clients)

    if new_win is None:
        log.warning("snap: could not find new window %r — falling back to unlock", new_win_address)
        unlock_camera()
        return

    # The leftmost existing window (first in sorted list, excluding the new one).
    existing = [w for w in wins if normalise_address(w.get("address", "")) != normalise_address(new_win_address)]
    if not existing:
        log.warning("snap: no existing windows to derive workarea from — falling back to unlock")
        unlock_camera()
        return

    first_win = existing[0]

    snapped = snap_right_then_unlock(new_win, first_win, col_w)
    if not snapped:
        log.warning("snap: fallback to plain unlock")
        unlock_camera()


# ── Event handlers ────────────────────────────────────────────────────────────

def on_workspacev2(payload: str) -> None:
    """
    socket2 event:  workspacev2>>workspaceid,workspacename

    Primary mechanism for instant left-alignment on first window:
    pre-locks the camera when switching to an empty scrolling workspace.
    Also corrects workspaces that gained or lost windows while inactive.

    sleep 0.02s: gives activeworkspace time to reflect the switch.
    """
    try:
        time.sleep(0.02)

        parts = payload.split(",", 1)
        if len(parts) < 2:
            log.debug("on_workspacev2: malformed payload %r", payload)
            return

        try:
            ws_id = int(parts[0])
        except ValueError:
            log.debug("on_workspacev2: bad id in %r", payload)
            return

        ws_name = parts[1]

        if ws_id < 0 or ws_name.startswith("special:"):
            log.debug("on_workspacev2: ignoring special ws '%s'", ws_name)
            return

        log.info("workspacev2 → ws '%s' (id=%d)", ws_name, ws_id)
        sync_active_workspace(new_win_address=None)

    except Exception as exc:
        log.error("on_workspacev2 unhandled exception: %s", exc, exc_info=True)


def on_openwindow(payload: str) -> None:
    """
    socket2 event:  openwindow>>windowaddress,workspacename,windowclass,windowtitle

    Handles:
    - Safety-net lock re-application for windows 1 and 2 (in case on_workspacev2
      didn't pre-lock in time).
    - Snap to right edge for the window that crosses the locked→unlocked threshold.

    Passes the new window's address to sync so the snap function can look up
    its actual screen position from hyprctl -j clients.

    Only acts on the currently active workspace. Windows opening on inactive
    workspaces are corrected by on_workspacev2 on next visit.

    sleep 0.02s: ensures the new window is positioned by the layout before we
    read its at[0]/size[0]. The openwindow event fires after mapping, so by
    20ms the layout has run recalculate() and set the window's position.
    """
    try:
        time.sleep(0.02)

        parts = payload.split(",", 3)
        if len(parts) < 2:
            log.debug("on_openwindow: malformed payload %r", payload)
            return

        win_address = parts[0]
        ws_name     = parts[1]

        if ws_name.startswith("special:"):
            log.debug("on_openwindow: ignoring special ws '%s'", ws_name)
            return

        active_ws = get_active_workspace()
        if active_ws is None:
            return
        if active_ws.get("name") != ws_name:
            log.debug(
                "on_openwindow: ws '%s' not active (active='%s') — skipping",
                ws_name, active_ws.get("name"),
            )
            return

        log.info("openwindow addr=%s on active ws '%s'", win_address, ws_name)
        sync_active_workspace(new_win_address=win_address)

    except Exception as exc:
        log.error("on_openwindow unhandled exception: %s", exc, exc_info=True)


def on_closewindow(_payload: str) -> None:
    """
    socket2 event:  closewindow>>windowaddress

    NO SLEEP. The closewindow event is posted by Hyprland after removeTarget()
    completes, so hyprctl -j clients is already accurate. Reacting immediately
    (before the centering animation progresses) prevents the subtle re-center
    glitch when closing the window that drops count below the unlock threshold.
    """
    try:
        log.info("closewindow — syncing immediately")
        sync_active_workspace(new_win_address=None)
    except Exception as exc:
        log.error("on_closewindow unhandled exception: %s", exc, exc_info=True)


def on_configreloaded() -> None:
    """
    socket2 event:  configreloaded>>  (empty payload)

    Re-applies the keyword override after a config reload. m_lockedOffset on
    each workspace's CScrollTapeController is not touched by the config reload
    callback (which only updates configuredWidths and direction), so individual
    workspace locks survive the reload.
    """
    try:
        log.info("configreloaded — re-applying keyword and syncing")
        keyword("scrolling:fullscreen_on_one_column", "false")
        time.sleep(0.05)
        sync_active_workspace(new_win_address=None)
    except Exception as exc:
        log.error("on_configreloaded unhandled exception: %s", exc, exc_info=True)


# ── Event loop ────────────────────────────────────────────────────────────────

def process(line: str) -> None:
    """
    Dispatch a single socket2 event line.
    Format per EventManager.cpp formatEvent(): EVENTTYPE>>DATA
    (newlines in data replaced with spaces; data truncated to 1024 chars)
    """
    if line.startswith("workspacev2>>"):
        on_workspacev2(line[len("workspacev2>>"):])
    elif line.startswith("openwindow>>"):
        on_openwindow(line[len("openwindow>>"):])
    elif line.startswith("closewindow>>"):
        on_closewindow(line[len("closewindow>>"):])
    elif line.startswith("configreloaded>>"):
        on_configreloaded()


def run() -> None:
    """
    Connect to Hyprland's socket2 and process events indefinitely.
    Reconnects automatically on socket drop.
    """
    path = socket2_path()
    log.info("Connecting to %s …", path)

    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(path)
                log.info("Connected. Listening for events.")

                buf = ""
                while True:
                    chunk = sock.recv(4096)
                    if not chunk:
                        log.warning("Socket closed — reconnecting …")
                        break
                    buf += chunk.decode("utf-8", errors="replace")
                    # EventManager sends one event per line terminated by \n
                    while "\n" in buf:
                        line, buf = buf.split("\n", 1)
                        line = line.strip()
                        if line:
                            process(line)

        except FileNotFoundError:
            log.error("Socket not found: %s — retrying in 3 s …", path)
            time.sleep(3)
        except (ConnectionRefusedError, OSError) as exc:
            log.error("Socket error: %s — retrying in 1 s …", exc)
            time.sleep(1)


# ── Entry point ───────────────────────────────────────────────────────────────

def main() -> None:
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        print(
            "Error: HYPRLAND_INSTANCE_SIGNATURE is not set.\n"
            "This script must run inside a live Hyprland session.",
            file=sys.stderr,
        )
        sys.exit(1)

    log.info("═" * 58)
    log.info("Hyprland Scrolling Layout — First-Window Manager")
    log.info("(patched build: lockcameraoffset IPC available)")
    log.info("═" * 58)

    keyword("scrolling:fullscreen_on_one_column", "false")
    log.info("fullscreen_on_one_column = false applied.")

    # Sync the active workspace on startup. workspacev2 does not fire for the
    # initial workspace at launch so we evaluate it manually here.
    time.sleep(0.05)
    sync_active_workspace(new_win_address=None)

    run()


if __name__ == "__main__":
    main()
