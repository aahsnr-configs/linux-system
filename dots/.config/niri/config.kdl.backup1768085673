// ============================================================================
// Niri Configuration - Combined Single File
// ============================================================================
// This file combines all separate configuration files into one comprehensive
// config.kdl for the niri wayland compositor.
//
// Original structure:
// - config.kdl (main configuration)
// - colors.kdl (color scheme)
// - layout.kdl (layout settings)
// - alttab.kdl (window switcher settings)
// - wpblur.kdl (wallpaper blur layer rule)
// - binds.kdl (keybindings)
// ============================================================================

// ============================================================================
// SYSTEM CONFIGURATION
// ============================================================================

config-notification {
    disable-failed
}

// ============================================================================
// STARTUP APPLICATIONS
// ============================================================================

spawn-at-startup "bash" "-c" "wl-paste --watch cliphist store &"
spawn-at-startup "udiskie"
spawn-at-startup "atuin" "daemon"
spawn-at-startup "emacs" "--daemon"
spawn-at-startup "rog-control-center"

// ============================================================================
// ENVIRONMENT VARIABLES

// environment {
//   XDG_CURRENT_DESKTOP "niri"
