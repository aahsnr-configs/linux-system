#!/bin/bash
echo "init"
sleep 5
sudo cp -R "$HOME/Git/configs/linux-system/tumbleweed/preconfig/99-custom-env.sh" "/etc/profile.d/"
sudo zypper ref
sudo zypper up
sudo zypper in curl wget git-core git-lfs gh unzip zip

echo "nvidia"
sleep 5
sudo zypper addrepo https://developer.download.nvidia.com/compute/cuda/repos/opensuse15/x86_64/cuda-opensuse15.repo
sudo zypper refresh
sudo zypper install nvidia-open

echo "installers"
sleep 5
curl -fsS https://dl.brave.com/install.sh | sh
curl -LsSf https://astral.sh/uv/install.sh | sh
curl -fsSL https://pixi.sh/install.sh | sh
curl -fsSL https://bun.com/install | bash
curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

echo "brew setup and pkgs"
sleep 5
cd
echo 'eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv bash)"' >>/home/ahsan/.bashrc
source ~/.bashrc
cd
brew install pandoc
brew install --cask font-jetbrains-mono
brew install --cask font-jetbrains-mono-nerd-font
brew install --cask font-noto-color-emoji
brew install --cask font-google-sans-code
brew install --cask font-symbols-only-nerd-font

echo "main pkgs"
sleep 5
sudo zypper in acpid aspell atuin bat bleachbit bluez bluez-firmware bpftune brightnessctl btop cava chafa cliphist cpio cronie ddcutil direnv distrobox dust emacs enchant-devel evolution-data-server eza fail2ban fastfetch fd flatpak fwupd fwupd-efi fzf gnome-keyring gnome-tweaks gnuplot go graphviz grim groff gsettings-desktop-schemas gtk4-layer-shell-devel gzip haveged hunspell hunspell-tools hypridle hyprpolkitagent i2c-tools ImageMagick imv inotify-tools ispell jq kitty kitty-shell-integration kitty-terminfo lazygit libgtk4-layer-shell0 logrotate luajit lynis meson mpv neovim nodejs24 npm24 nwg-look opi papers papirus-icon-theme pciutils pipewire pipewire-alsa pipewire-jack pipewire-pulseaudio pkgconf-pkg-config plantuml podman podman-docker profile-sync-daemon python313-pipx python313-pymol qt5ct qt6ct ryzenadj slurp starship swappy switcheroo-control tealdeer thunar thunar-archive-plugin thunar-media-tags-plugin thunar-volman tmux topgrade transmission-gtk trash-cli ucode-amd udiskie wireplumber wl-clipboard wlsunset xdg-desktop-portal-gnome xdg-desktop-portal-gtk xdg-desktop-portal-hyprland xdg-user-dirs xdg-user-dirs-gtk yazi zathura zathura-plugin-pdf-mupdf zeromq-devel zeromq-tools zoxide zram-generator zsh zstd

echo "rust pkgs"
sleep 5
rustup default stable
cargo install emacs-lsp-booster texlab pay-respects

echo "piavpn"
sleep 5
PIA_INSTALLER=$(mktemp --suffix=.run)
trap "rm -f '$PIA_INSTALLER'" EXIT
wget -O "$PIA_INSTALLER" https://installers.privateinternetaccess.com/download/pia-linux-3.6.2-08398.run
chmod +x "$PIA_INSTALLER"
bash "$PIA_INSTALLER"

echo "Opi pkgs"
sleep 5
opi codecs
opi texlive-dummy
opi adw-gtk3
opi hyprland-guiutils
opi ly
opi noctalia-shell
opi zotero
opi zen-browser

echo "Build and Install asusctl"
sleep 5
cd && git clone https://gitlab.com/asus-linux/asusctl.git
cd asusctl
sudo zypper in -t pattern devel_basis
zypper in make cmake clang-devel libxkbcommon-devel systemd-devel expat-devel pcre2-devel libzstd-devel gtk3-devel
make -j8
sudo make install && cd

echo "symlink and directory"
sleep 5
ln -sv "$HOME/Git/configs/linux-system/dots/bin/" "$HOME/"
sudo rm -rf ~/.zshrc
ln -sv "$HOME/Git/configs/linux-system/dots/.zshrc" "$HOME/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/atuin/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/bat/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/btop/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/enchant/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/fd/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/gh/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/kitty/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/home-manager/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/hypr/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/imv/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/lazygit/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/nvim/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/pipewire/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/pypr/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/swappy/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/tealdeer/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/tmux/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/xdg-desktop-portal/" "$HOME/.config"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/yazi/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/zathura/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/chrome-flags.conf" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/electron-flags.conf" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/mimeapps.list" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/starship.toml" "$HOME/.config/"
sudo rm -rf ~/.config/user-dirs.dirs
ln -sv "$HOME/Git/configs/linux-system/dots/.config/user-dirs.dirs" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/.config/noctalia/" "$HOME/.config/"
ln -sv "$HOME/Git/configs/linux-system/dots/tmp/" "$HOME/"

# Configure User
mkdir -p "$HOME/.npm-global"
npm config set prefix "$HOME/.npm-global"

echo "piavpn"
sleep 5
PIA_INSTALLER=$(mktemp --suffix=.run)
trap "rm -f '$PIA_INSTALLER'" EXIT
wget -O "$PIA_INSTALLER" https://installers.privateinternetaccess.com/download/pia-linux-3.6.2-08398.run
chmod +x "$PIA_INSTALLER"
bash "$PIA_INSTALLER"

systemctl --user enable wireplumber.service pipewire.service pipewire-pulse.service
systemctl --user enable gnome-keyring-daemon

chsh -s $(which zsh)
