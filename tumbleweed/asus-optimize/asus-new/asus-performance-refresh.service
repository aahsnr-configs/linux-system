# =============================================================================
# /etc/systemd/system/asus-performance-refresh.service
#
# Companion service for asus-performance-refresh.timer.
# Called by the timer every 60 seconds to re-apply PPT sysfs limits,
# throttle_thermal_policy, and ryzenadj values.
#
# WHY A PERIODIC REFRESH IS NEEDED
#
# The ASUS embedded controller and AMD firmware platform can reset ryzenadj
# SMU values at any time — not just at boot.  Known triggers include:
#   • AC adapter plug / unplug events (the EC recalibrates power envelopes)
#   • Any platform_profile write (GNOME power slider, hotkeys, other daemons)
#   • Background EC timer resets (firmware-specific, unpredictable)
#
# A one-shot application at boot and on resume is not sufficient to hold
# custom limits throughout a session.  This timer ensures limits are silently
# re-applied every 60 seconds, making any firmware reset have at most a
# 60-second window of effect.
#
# The service is intentionally not Type=oneshot + RemainAfterExit=yes because
# the timer restarts it fresh each time.
#
# Install with:  sudo ./install.sh
# =============================================================================

[Unit]
Description=ASUS G14 Performance Profile (Periodic Refresh)
Documentation=https://github.com/FlyGoat/RyzenAdj

# Must run after the boot unit has fired on the first cycle.
After=asus-performance.service

[Service]
Type=oneshot

ExecStart=/usr/local/bin/asus-performance-setup.sh

# Generous timeout for the refresh run.  Identical reasoning to the boot unit.
TimeoutStartSec=60

# Treat exit code 1 as success for the same reason as the boot unit.
SuccessExitStatus=0 1
