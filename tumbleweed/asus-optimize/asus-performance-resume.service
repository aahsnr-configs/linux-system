# =============================================================================
# /etc/systemd/system/asus-performance-resume.service
#
# Re-applies the ASUS G14 performance profile after the system wakes from
# ANY sleep state.  sleep.target is the single common parent of all four
# Linux sleep targets, so one WantedBy=sleep.target entry covers all of:
#
#   suspend               (RAM sleep  / S3)  →  suspend.target
#   hibernate             (disk sleep / S4)  →  hibernate.target
#   hybrid-sleep          (RAM + disk)       →  hybrid-sleep.target
#   suspend-then-hibernate                   →  suspend-then-hibernate.target
#
# Script installed at:  /usr/local/bin/asus-performance-setup.sh
# Companion unit:       asus-performance.service  (boot/restart)
# Install with:         sudo ./install.sh
#
# ── How the ExecStop= wake pattern works ─────────────────────────────────────
#
#  BEFORE SLEEP:
#   1. User runs `systemctl suspend` (or equivalent).
#   2. systemd activates sleep.target.
#   3. Because WantedBy=sleep.target, systemd starts this unit.
#   4. ExecStart=/bin/true runs — a deliberate no-op.
#   5. RemainAfterExit=yes keeps the unit "active" throughout sleep.
#
#  DURING SLEEP:
#   • The unit sits "active (exited)" — no processes, no CPU usage.
#
#  ON WAKE:
#   1. The hardware resumes; systemd deactivates sleep.target.
#   2. StopWhenUnneeded=yes sees that nothing requires this unit anymore
#      (sleep.target is gone) and tells systemd to stop it.
#   3. Stopping a oneshot unit with RemainAfterExit=yes runs ExecStop=.
#   4. ExecStop=/usr/local/bin/asus-performance-setup.sh fires.  ✓
#      The firmware's power limits have been reset by the wake transition;
#      the script re-applies them.
#
#  WHY NOT use After=suspend.target / After=hibernate.target ?
#   Those targets are active *before* sleep begins, not after resume.
#   The ExecStop= approach is the correct systemd idiom for post-resume
#   execution.  It is confirmed in the systemd-devel mailing list archives
#   and used in production (e.g. bluefin, wicd, network managers).
# =============================================================================

[Unit]
Description=ASUS G14 Performance Profile (Resume from Sleep/Hibernate)
Documentation=https://github.com/FlyGoat/RyzenAdj

# DefaultDependencies=no removes implicit After=basic.target,
# After=sysinit.target, Before=shutdown.target, and Conflicts=shutdown.target
# that systemd adds to all services by default.
#
# These implicit dependencies are designed for normal long-running services
# and are counter-productive for a sleep hook:
#   • After=basic.target would prevent the unit from being ordered cleanly
#     relative to sleep.target during sleep entry.
#   • Before=shutdown.target / Conflicts=shutdown.target are irrelevant
#     here; this unit is only ever started by sleep.target, not at boot.
#
# /usr/local/bin is on the root filesystem which remains mounted throughout
# sleep/wake cycles, so removing After=local-fs.target is safe.
DefaultDependencies=no

# Ordered before sleep.target so systemd registers this unit's state before
# sleep begins.  This is what makes StopWhenUnneeded=yes work correctly on
# wake: systemd knows the unit was active and stops it when sleep.target
# deactivates, which triggers ExecStop=.
Before=sleep.target

# Stop this unit when no active unit requires or wants it anymore.
# Since the only unit that pulls us in is sleep.target (via WantedBy),
# this unit will be stopped automatically when sleep.target deactivates
# (i.e. immediately after the system resumes).  That stop is what fires
# ExecStop= below.
StopWhenUnneeded=yes

[Service]
Type=oneshot

# Required for ExecStop= to run on unit stop.  Without this, systemd
# considers the unit already "inactive" after ExecStart= finishes and
# will not run ExecStop= when the unit is later stopped.
RemainAfterExit=yes

# A no-op placeholder.  systemd requires a non-empty ExecStart= for
# oneshot units.  The prefix "-" means "ignore if this command fails"
# (it won't, but it makes the intent unambiguous).
ExecStart=-/bin/true

# This is the real payload — runs on wake when the unit is stopped.
ExecStop=/usr/local/bin/asus-performance-setup.sh

# Generous stop timeout for post-hibernate scenarios where driver
# re-initialisation may delay the asus-nb-wmi sysfs nodes being ready.
TimeoutStopSec=90

[Install]
# sleep.target is the common parent of suspend.target, hibernate.target,
# hybrid-sleep.target, and suspend-then-hibernate.target.
# One line here covers all four sleep states.
WantedBy=sleep.target
