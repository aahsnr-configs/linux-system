# =============================================================================
# /etc/systemd/system/asus-performance-resume.service
#
# Re-applies the ASUS G14 performance profile after the system wakes from
# ANY sleep state.  sleep.target is the single common parent of all four
# Linux sleep targets, so one WantedBy=sleep.target entry covers all of:
#
#   suspend               (RAM sleep  / S3)  →  suspend.target
#   hibernate             (disk sleep / S4)  →  hibernate.target
#   hybrid-sleep          (RAM + disk)       →  hybrid-sleep.target
#   suspend-then-hibernate                   →  suspend-then-hibernate.target
#
# Script installed at:  /usr/local/bin/asus-performance-setup.sh
# Companion unit:       asus-performance.service  (boot/restart)
# Refresh unit:         asus-performance-refresh.timer  (periodic)
# Install with:         sudo ./install.sh
#
# ── How the ExecStop= wake pattern works ─────────────────────────────────────
#
#  BEFORE SLEEP:
#   1. User runs `systemctl suspend` (or equivalent).
#   2. systemd activates sleep.target.
#   3. Because WantedBy=sleep.target, systemd starts this unit.
#   4. ExecStart=/bin/true runs — a deliberate no-op.
#   5. RemainAfterExit=yes keeps the unit "active" throughout sleep.
#
#  DURING SLEEP:
#   • The unit sits "active (exited)" — no processes, no CPU usage.
#
#  ON WAKE:
#   1. The hardware resumes; systemd deactivates sleep.target.
#   2. StopWhenUnneeded=yes sees that nothing requires this unit anymore
#      (sleep.target is gone) and tells systemd to stop it.
#   3. Stopping a oneshot unit with RemainAfterExit=yes runs ExecStop=.
#   4. ExecStop= fires a short delay followed by the setup script.  ✓
#
# ── WHY THE 3-SECOND DELAY IN ExecStop= ──────────────────────────────────────
#
# With DefaultDependencies=no, this unit has no implicit ordering relative to
# driver re-initialisation.  After a hibernate resume in particular, the
# asus-nb-wmi kernel module takes a moment to re-register its sysfs nodes
# with the embedded controller.  If the setup script fires too early, sysfs
# writes return exit code 0 (the node exists and accepts bytes) but the EC
# never actually receives the values because the WMI transport layer is still
# initialising.
#
# A 3-second delay before the script reliably covers this race condition
# without adding perceptible latency to the user experience.
#
# ── WHY DefaultDependencies=no ───────────────────────────────────────────────
#
# DefaultDependencies=no removes the implicit After=basic.target,
# After=sysinit.target, Before=shutdown.target, and Conflicts=shutdown.target
# dependencies that systemd adds to all services by default.
#
# These implicit dependencies are designed for normal long-running services
# and are counter-productive for a sleep hook:
#   • After=basic.target would prevent clean ordering relative to sleep.target.
#   • Before=shutdown.target / Conflicts=shutdown.target are irrelevant here;
#     this unit is only ever started by sleep.target, not at boot.
#
# /usr/local/bin is on the root filesystem which remains mounted throughout
# all sleep/wake cycles, so removing After=local-fs.target is safe.
# =============================================================================

[Unit]
Description=ASUS G14 Performance Profile (Resume from Sleep/Hibernate)
Documentation=https://github.com/FlyGoat/RyzenAdj

DefaultDependencies=no

# Ordered before sleep.target so systemd registers this unit's state before
# sleep begins.  This is what makes StopWhenUnneeded=yes work on wake:
# systemd knows the unit was active and stops it when sleep.target deactivates,
# which fires ExecStop=.
Before=sleep.target

# Stop this unit automatically when sleep.target deactivates (on wake).
# Since the only thing that pulls us in is sleep.target (via WantedBy),
# the unit will be stopped as soon as sleep.target is no longer active.
# That automatic stop is what triggers ExecStop=.
StopWhenUnneeded=yes

[Service]
Type=oneshot

# Required for ExecStop= to run on unit stop.  Without this, systemd
# considers the unit already "inactive" after ExecStart= finishes and
# will not run ExecStop= when the unit is later stopped.
RemainAfterExit=yes

# A deliberate no-op placeholder.  systemd requires a non-empty ExecStart=
# for oneshot units.  The "-" prefix means "ignore failure" (it won't fail,
# but the intent is explicit).
ExecStart=-/bin/true

# The real payload.  Fires on wake when the unit is stopped by
# StopWhenUnneeded=yes as sleep.target deactivates.
#
# The 3-second sleep before the script is intentional — see the header comment
# above for the full explanation of the WMI re-initialisation race.
ExecStop=/bin/bash -c 'sleep 3 && /usr/local/bin/asus-performance-setup.sh'

# Generous stop timeout: hibernate resume can take longer than suspend resume
# before drivers are fully re-initialised.  The 3-second delay plus the
# script runtime (≈4 seconds) is comfortably within this limit.
TimeoutStopSec=90

[Install]
# sleep.target is the common parent of suspend.target, hibernate.target,
# hybrid-sleep.target, and suspend-then-hibernate.target.
# One entry here covers all four sleep states.
WantedBy=sleep.target
