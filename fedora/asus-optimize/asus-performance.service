# =============================================================================
# /etc/systemd/system/asus-performance.service
#
# Runs the ASUS G14 performance setup script once on every cold boot and
# restart.  Wake-from-sleep handling is done separately by:
#   asus-performance-resume.service
#
# Periodic refresh (to re-apply limits after firmware or daemon resets) is
# done by:
#   asus-performance-refresh.timer / asus-performance-refresh.service
#
# Script installed at:  /usr/local/bin/asus-performance-setup.sh
# Diagnostic utility:   /usr/local/bin/asus-kernel-check.sh
# Install with:         sudo ./install.sh
#
# ── COMPATIBILITY NOTE: kernel 6.18 and 6.19+ ────────────────────────────────
#
# This unit is kernel-version-agnostic.  The setup script it calls
# auto-detects whether to use the asus-armoury firmware-attributes interface
# (kernel 6.19+ or CachyOS backport) or the legacy asus-nb-wmi platform sysfs
# (kernel 6.5–6.18).  throttle_thermal_policy is always at the platform path
# on all kernel versions and is handled separately from PPT detection.
#
# ── WHY ONLY After=local-fs.target IS LISTED ─────────────────────────────────
#
# This unit is WantedBy=multi-user.target.  systemd implicitly adds
# Before=multi-user.target to any unit placed in multi-user.target.wants/.
#
# The most common reason this service fails at boot and must be started
# manually is a spurious ordering cycle in the boot graph:
#
#   ORDERING CYCLE PATH 1 (power-profiles-daemon):
#     power-profiles-daemon.service has Before=multi-user.target in its own
#     unit file.  Adding After=power-profiles-daemon.service would create:
#       multi-user.target → [this unit] → ppd → multi-user.target
#
#   ORDERING CYCLE PATH 2 (dbus.service / dbus-broker.service):
#     On Fedora, dbus.service is a symlink to dbus-broker.service.
#     dbus-broker.service has After=sysinit.target in its own unit file.
#     Combined with our own After=sysinit.target, this creates a transitive
#     graph path that the systemd cycle resolver can flag.  Specifically,
#     dbus-broker.service has Before=multi-user.target, so:
#       multi-user.target → [this unit] → dbus.service → multi-user.target
#     This is ALSO an ordering cycle.  Even though dbus.service looks safe
#     at first glance, the cycle resolver follows transitive paths.
#
# In both cases, systemd resolves the cycle by deleting this unit's start job:
#
#   "Found ordering cycle: multi-user.target/start
#    after asus-performance.service/start
#    after [dbus|ppd|asusd].service/start — after multi-user.target"
#   "Job asus-performance.service/start deleted to break ordering cycle"
#
# This explains why the service silently never starts at boot but works
# perfectly when started manually with `systemctl start`.
#
# THE ONLY SAFE After= ENTRY IS local-fs.target:
#   • Guarantees /usr/local/bin is mounted before the script runs.
#   • Has Before=sysinit.target (not After=multi-user.target) — no cycle path.
#   • This script does not use D-Bus, so After=dbus.service is both
#     unnecessary and harmful.
#   • It does not use systemd units that depend on multi-user.target.
#
# ── HOW "DAEMONS START AFTER US AND OVERWRITE OUR LIMITS" IS HANDLED ─────────
#
# The correct solution is NOT to order after the daemons.  Instead:
#
#   1. This unit fires early (after local-fs.target only) and applies limits
#      as a first pass.  The setup script has a built-in sysfs readiness wait
#      loop (up to 15 seconds, polling every second) to handle the case where
#      kernel modules haven't finished creating their sysfs nodes yet.
#
#   2. asus-performance-refresh.timer fires at T+90s and then every 60s.
#      This is always after asusd and power-profiles-daemon have finished
#      their boot-time profile restore.  The timer is the definitive mechanism
#      for ensuring limits stick after daemon resets.
#
#   3. Restart=on-failure with RestartSec=15 provides a safety net: if the
#      script exits non-zero (sysfs nodes still not available after the wait
#      loop, or ryzenadj failed hard), systemd retries after 15 seconds.
#      By that point, all kernel modules are reliably up.
# =============================================================================

[Unit]
Description=ASUS G14 Performance Profile (Boot) — kernel 6.18 / 6.19+ / CachyOS
Documentation=https://github.com/FlyGoat/RyzenAdj

# ── Ordering ──────────────────────────────────────────────────────────────────
# local-fs.target  → /usr/local/bin is guaranteed mounted and readable.
#
# That is the ONLY safe entry here.  Do NOT add any of the following —
# each creates an ordering cycle that causes systemd to silently delete
# this unit's start job (see the header comment above for the full analysis):
#
#   ✗ After=sysinit.target              (transitive cycle via dbus-broker)
#   ✗ After=dbus.service                (cycle: this → dbus → multi-user.target)
#   ✗ After=power-profiles-daemon.service  (direct cycle via multi-user.target)
#   ✗ After=asusd.service               (same cycle path as ppd)
After=local-fs.target

# ── Sleep interaction ─────────────────────────────────────────────────────────
# Conflicts=sleep.target transitions this unit to "inactive" when any sleep
# state begins.  This is informational only — it accurately reflects that the
# profile has not been re-applied since the last wake.  The resume unit handles
# wake events independently.
Conflicts=sleep.target

[Service]
Type=oneshot

# RemainAfterExit=yes keeps the unit in "active (exited)" state after
# ExecStart finishes.  Required for Conflicts=sleep.target to work correctly:
# systemd can only conflict an "active" unit.
RemainAfterExit=yes

ExecStart=/usr/local/bin/asus-performance-setup.sh

# Generous timeout — the setup script polls for sysfs readiness for up to
# 15 seconds before running, then writes sysfs values and calls ryzenadj.
# Total worst-case runtime is approximately 20 seconds.
TimeoutStartSec=120

# ── Retry on failure ──────────────────────────────────────────────────────────
# If the script exits non-zero (sysfs nodes not available even after the
# 15-second readiness wait, or an unexpected error under set -euo pipefail),
# systemd will retry the unit after 15 seconds.  By 15 seconds post-boot,
# all kernel modules are reliably initialised regardless of boot speed.
#
# RestartSec=15      — pause 15 seconds before the retry attempt
# StartLimitBurst=3  — allow at most 3 start attempts within the interval
# StartLimitIntervalSec=90 — reset the attempt counter after 90 seconds
#
# NOTE: Restart= only fires when the unit exits with a failure status.
# The script exits 0 on success and 1 when nothing could be applied
# (sysfs unavailable + no ryzenadj).  Exit 1 triggers a retry here.
Restart=on-failure
RestartSec=15
StartLimitBurst=3
StartLimitIntervalSec=90

[Install]
WantedBy=multi-user.target
