#!/usr/bin/env bash
# =============================================================================
# build-emacs.sh — Build and install GNU Emacs 30.2 from source
#
# Target OS    : Fedora Linux 43 (or later)
# Features     : Native compilation (--with-native-compilation=aot)  [mandatory]
#                Wayland via pure-GTK3 (--with-pgtk)                  [mandatory]
# Install to   : /usr/local  (override with EMACS_PREFIX env var)
# Idempotent   : Re-running is safe. Skips build if 30.2 is already installed.
#                Override with: sudo FORCE_REBUILD=1 bash build-emacs.sh
# Usage        : sudo bash build-emacs.sh
# =============================================================================

set -euo pipefail

# ── Configuration ─────────────────────────────────────────────────────────────
readonly EMACS_VERSION="30.2"
readonly EMACS_TARBALL="emacs-${EMACS_VERSION}.tar.xz"
readonly EMACS_URL="https://ftp.gnu.org/gnu/emacs/${EMACS_TARBALL}"
# Official SHA-256 from the GNU release announcement (14 Aug 2025).
readonly EMACS_SHA256="b3f36f18a6dd2715713370166257de2fae01f9d38cfe878ced9b1e6ded5befd9"
readonly PREFIX="${EMACS_PREFIX:-/usr/local}"
readonly JOBS="$(nproc)"
# Persistent cache dir — tarball survives between runs so re-runs don't
# re-download unless the cached copy fails its checksum.
readonly CACHE_DIR="/var/cache/emacs-src"
readonly FORCE_REBUILD="${FORCE_REBUILD:-0}"

# ── Helpers ───────────────────────────────────────────────────────────────────
info() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
ok() { printf '  \033[1;32m✓ %s\033[0m\n' "$*"; }
skip() { printf '  \033[1;33m● %s\033[0m\n' "$*"; }
die() {
    printf '\n\033[1;31mERROR: %s\033[0m\n' "$*" >&2
    exit 1
}

# ── Temp build directory — cleaned up on every exit ───────────────────────────
BUILD_DIR="$(mktemp -d /tmp/emacs-build.XXXXXX)"
readonly BUILD_DIR
cleanup() { rm -rf "${BUILD_DIR}"; }
trap cleanup EXIT

# ── Pre-flight checks ─────────────────────────────────────────────────────────
[[ "${EUID}" -eq 0 ]] || die "This script must be run as root (use: sudo bash $0)"

if ! grep -q '^ID=fedora$' /etc/os-release 2>/dev/null; then
    die "This script targets Fedora Linux only."
fi

fedora_ver="$(grep '^VERSION_ID=' /etc/os-release | cut -d= -f2)"
if [[ "${fedora_ver}" -lt 43 ]] 2>/dev/null; then
    printf '  \033[1;33mWARN: Designed for Fedora 43+; detected Fedora %s.\033[0m\n' \
        "${fedora_ver}"
fi
ok "Running on Fedora ${fedora_ver}"

# ── Idempotency gate ──────────────────────────────────────────────────────────
# If the target binary already exists and reports the correct version, there is
# nothing to do.  Set FORCE_REBUILD=1 to skip this check and rebuild anyway.
emacs_bin="${PREFIX}/bin/emacs"
if [[ -x "${emacs_bin}" ]]; then
    installed_ver="$("${emacs_bin}" --version 2>/dev/null | awk 'NR==1{print $3}')"
    if [[ "${installed_ver}" == "${EMACS_VERSION}" ]]; then
        if [[ "${FORCE_REBUILD}" != "1" ]]; then
            skip "Emacs ${EMACS_VERSION} is already installed at ${emacs_bin}."
            skip "Nothing to do. To rebuild, run: sudo FORCE_REBUILD=1 bash $0"
            exit 0
        fi
        info "FORCE_REBUILD=1 — rebuilding Emacs ${EMACS_VERSION} from scratch."
    fi
fi

# ── Install build dependencies ────────────────────────────────────────────────
# Package list is derived directly from the official Fedora rawhide emacs.spec
# BuildRequires, filtered to those relevant to a --with-pgtk source build.
# Notably absent (intentionally):
#   gcc-c++      — Emacs is pure C; libgccjit is a C API; not required.
#   systemd-devel — Only needed for a Fedora-specific patch (emacs-libdir-vs-
#                   systemd.patch) that is applied to the RPM build. We build
#                   the clean upstream tarball, so this dep does not apply.
info "Installing build dependencies..."
dnf install -y \
    alsa-lib-devel \
    atk-devel \
    autoconf \
    bzip2 \
    cairo-devel \
    dbus-devel \
    fontconfig-devel \
    freetype-devel \
    gcc \
    giflib-devel \
    glibc-devel \
    gnutls-devel \
    gtk3-devel \
    gzip \
    harfbuzz-devel \
    jansson-devel \
    libacl-devel \
    libgccjit-devel \
    libjpeg-turbo-devel \
    libotf-devel \
    libpng-devel \
    librsvg2-devel \
    libselinux-devel \
    libtiff-devel \
    libtree-sitter-devel \
    libwebp-devel \
    libxml2-devel \
    m17n-lib-devel \
    make \
    ncurses-devel \
    sqlite-devel \
    texinfo \
    wget \
    zlib-devel
ok "All dependencies installed."

# ── Obtain source tarball (with caching) ──────────────────────────────────────
mkdir -p "${CACHE_DIR}"
cached_tarball="${CACHE_DIR}/${EMACS_TARBALL}"

need_download=1
if [[ -f "${cached_tarball}" ]]; then
    info "Cached tarball found. Verifying checksum..."
    cached_sha="$(sha256sum "${cached_tarball}" | awk '{print $1}')"
    if [[ "${cached_sha}" == "${EMACS_SHA256}" ]]; then
        ok "Cached tarball is valid. Skipping download."
        need_download=0
    else
        printf '  \033[1;33mWARN: Cached tarball checksum mismatch; deleting and re-downloading.\033[0m\n'
        rm -f "${cached_tarball}"
    fi
fi

if [[ "${need_download}" -eq 1 ]]; then
    info "Downloading Emacs ${EMACS_VERSION} to ${CACHE_DIR}..."
    wget --quiet --show-progress -O "${cached_tarball}" "${EMACS_URL}"

    info "Verifying SHA-256 checksum..."
    actual_sha="$(sha256sum "${cached_tarball}" | awk '{print $1}')"
    if [[ "${actual_sha}" != "${EMACS_SHA256}" ]]; then
        rm -f "${cached_tarball}"
        die "Checksum mismatch on downloaded file!
  Expected : ${EMACS_SHA256}
  Got      : ${actual_sha}
  The file has been removed. Check your network and retry."
    fi
    ok "Checksum verified."
fi

# ── Extract into the temporary build directory ────────────────────────────────
info "Extracting source..."
tar -xf "${cached_tarball}" -C "${BUILD_DIR}"
cd "${BUILD_DIR}/emacs-${EMACS_VERSION}"

# ── Configure ─────────────────────────────────────────────────────────────────
# CFLAGS note: -DMAIL_USE_LOCKF is set explicitly in Fedora's emacs.spec
# (export CFLAGS="-DMAIL_USE_LOCKF %{build_cflags}") to ensure correct
# mailbox file locking on Linux. We carry it here for the same reason.
info "Running ./configure..."
CFLAGS="-DMAIL_USE_LOCKF" \
    ./configure \
    --with-native-compilation=aot \
    --with-pgtk \
    --with-cairo \
    --with-dbus \
    --with-gif \
    --with-gpm=no \
    --with-harfbuzz \
    --with-mailutils \
    --with-jpeg \
    --with-modules \
    --with-png \
    --with-rsvg \
    --with-sqlite3 \
    --with-tiff \
    --with-webp \
    --with-xml2 \
    --without-compress-install

# ── Verify mandatory features were actually enabled ───────────────────────────
# ./configure writes its decisions into src/config.h as preprocessor defines.
# This is the authoritative record of what was actually enabled — far more
# reliable than grepping config.log or running an unbuilt binary.
info "Verifying mandatory features in src/config.h..."

if ! grep -q '^#define HAVE_NATIVE_COMP 1' src/config.h; then
    die "Native compilation was NOT enabled.
  libgccjit-devel was listed as a dependency and should have been installed.
  Check: rpm -q libgccjit-devel
  Then check configure output above for any libgccjit-related errors."
fi
ok "Native compilation (HAVE_NATIVE_COMP) : enabled"

if ! grep -q '^#define HAVE_PGTK 1' src/config.h; then
    die "PGTK / Wayland support was NOT enabled.
  gtk3-devel was listed as a dependency and should have been installed.
  Check: rpm -q gtk3-devel
  Then check configure output above for any GTK-related errors."
fi
ok "PGTK / Wayland (HAVE_PGTK)            : enabled"

# ── Build ─────────────────────────────────────────────────────────────────────
info "Building Emacs with ${JOBS} parallel jobs (this will take several minutes)..."
make -j"${JOBS}"

# ── Install ───────────────────────────────────────────────────────────────────
info "Installing to ${PREFIX}..."
make install

# Refresh the dynamic linker cache so the installed binary can locate
# libgccjit.so at runtime without requiring manual LD_LIBRARY_PATH tweaks.
ldconfig
ok "Installation complete."

# ── Post-install verification ─────────────────────────────────────────────────
info "Verifying the installed binary..."

[[ -x "${emacs_bin}" ]] || die "Expected binary not found at ${emacs_bin}"

version_string="$("${emacs_bin}" --version 2>&1 | head -1)"
ok "Reported version : ${version_string}"

# Run a headless sanity-check for native-comp availability.
# In --batch mode Emacs can probe libgccjit without opening a display.
native_status="$(
    "${emacs_bin}" --batch -Q \
        --eval '(message "%s" (if (native-comp-available-p) "yes" "no"))' \
        2>&1 | tail -1
)"
if [[ "${native_status}" == "yes" ]]; then
    ok "native-comp available at runtime"
else
    printf '  \033[1;33mWARN: native-comp probe returned "%s".\033[0m\n' \
        "${native_status}"
    printf '  \033[1;33m      Try: sudo ldconfig  then re-run: %s --batch -Q\033[0m\n' \
        "${emacs_bin}"
    printf '  \033[1;33m      --eval "(message \"%%s\" (if (native-comp-available-p) \"yes\" \"no\"))"\033[0m\n'
fi

# ── Final summary ─────────────────────────────────────────────────────────────
printf '\n\033[1;32m%s\033[0m\n' \
    "════════════════════════════════════════════════════"
printf '\033[1;32m  GNU Emacs %s built and installed successfully.\033[0m\n\n' \
    "${EMACS_VERSION}"
printf '  Binary     : %s\n' "${emacs_bin}"
printf '  Wayland    : Automatic in a Wayland desktop session.\n'
printf '               Force it explicitly: GDK_BACKEND=wayland emacs\n'
printf '  Rebuild    : sudo FORCE_REBUILD=1 bash %s\n' "$0"
printf '\033[1;32m%s\033[0m\n\n' \
    "════════════════════════════════════════════════════"
