# /etc/portage/env/clang-lto-env
# Base environment for compiling select packages with a modern Clang/LLVM toolchain.
# Uses ThinLTO for performance with fast link times.

# I. Compiler Flags
COMMON_FLAGS="-O3 -pipe -march=native -flto=thin -fno-semantic-interposition -fno-plt"
CFLAGS="${COMMON_FLAGS}"
CXXFLAGS="${COMMON_FLAGS}"

# II. Hardening Flags
HARDENING_FLAGS="-fcf-protection -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fstack-clash-protection"
CFLAGS="${CFLAGS} ${HARDENING_FLAGS}"
CXXFLAGS="${CXXFLAGS} ${HARDENING_FLAGS}"

# III. Toolchain Executables
CC="clang"
CXX="clang++"
AR="llvm-ar"
LD="ld.lld"
NM="llvm-nm"
RANLIB="llvm-ranlib"

# IV. Linker & Rust Configuration
# Note: -flto=thin is already in COMMON_FLAGS, so the compiler driver passes it to the linker automatically.
LDFLAGS="-fuse-ld=lld -Wl,-O2 -Wl,--as-needed"
RUSTFLAGS="-C target-cpu=native -C opt-level=3 -Clinker=clang -Clink-arg=-fuse-ld=lld"