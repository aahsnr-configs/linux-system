# /etc/portage/package.env
# Assigns build environments to packages.
# Strategy: Enhance performance without sacrificing stability.
#
# Environments Used:
#   - clang-lto-env: Compiles with Clang and ThinLTO for modern optimization.
#   - polly-on-env:  Adds Polly's loop optimizations (combined with clang-lto-env).
#   - (none):        Uses the default system compiler (GCC), ensuring stability.

# =======================================================================
# A. System Toolchain -> MUST USE DEFAULT COMPILER (GCC)
# =======================================================================
# Applying a custom Clang environment to the toolchain itself is called
# bootstrapping. It is highly unstable and can lead to build failures.
# These packages build the foundation of your system and must use the
# default, most stable compiler available.
#
# DO NOT add entries for:
# sys-devel/gcc
# dev-lang/rust
# llvm-core/* (e.g., llvm, clang, lld)
# llvm-runtimes/*

# =======================================================================
# B. Polly Candidates -> clang-lto-env + polly-on-env
# =======================================================================
# Heavy mathematical/graphical computations where polyhedral loop
# optimizations may provide a measurable benefit.
media-libs/mesa                            clang-lto-env polly-on-env
gnome-base/librsvg                         clang-lto-env polly-on-env
sci-libs/gsl                               clang-lto-env polly-on-env

# =======================================================================
# C. Clang/LTO Candidates -> clang-lto-env ONLY
# =======================================================================
# Packages that benefit significantly from Clang codegen and fast LLD
# linking. Many are Rust-based or large C codebases. Polly is not used.

# --- Multimedia & Codecs (Huge win for Clang/LLD) ---
media-video/ffmpeg                         clang-lto-env
media-video/libavif                        clang-lto-env
media-libs/dav1d                           clang-lto-env
media-libs/aom                             clang-lto-env
media-libs/x264                            clang-lto-env
media-libs/libvpx                          clang-lto-env

# --- Core System ---
sys-apps/systemd                           clang-lto-env
sys-fs/btrfs-progs                         clang-lto-env
sys-libs/zlib                              clang-lto-env
dev-db/sqlite                              clang-lto-env

# --- Rust-Based CLI Tools (Benefit from LLD fast linking) ---
app-shells/atuin                           clang-lto-env
app-shells/starship                        clang-lto-env
app-shells/zoxide                          clang-lto-env
app-misc/czkawka                           clang-lto-env
app-misc/yazi                              clang-lto-env
gui-apps/alacritty-graphics                clang-lto-env
sys-apps/bat                               clang-lto-env
sys-apps/eza                               clang-lto-env
sys-apps/fd                                clang-lto-env
sys-process/bottom                         clang-lto-env
sys-apps/ripgrep                           clang-lto-env
dev-util/git-delta                         clang-lto-env

# =======================================================================
# D. Unsuitable / Default GCC
# =======================================================================
# Core libraries sensitive to ABI changes or I/O bound with no
# computational loops. Leave commented out to use the default environment.
# app-editors/neovim
# net-libs/curl
# dev-libs/openssl