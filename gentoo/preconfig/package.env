# /etc/portage/package.env
# Last reviewed: May 2026
#
# Env files in use:
#   clang-lto-env        — Clang toolchain + ThinLTO + -O3 baseline
#   polly-on-env         — Polly loop tiling / vectorizer / fusion, no OpenMP
#                          Safe for all pure C/C++ 64-bit packages.
#   polly-parallel-env   — Polly + OpenMP parallel codegen via LLVM libomp.
#                          Only for packages with real nested loops and no
#                          internal thread pool of their own.
#
# Ground rules enforced here:
#
#   1. cmake is built with GCC — no clang-lto-env.
#
#   2. Pure Rust packages (cargo.eclass) get clang-lto-env ONLY.
#      polly flags in CFLAGS are inert for rustc. Any flag that lands in
#      LDFLAGS becomes -C link-arg= and can break the Rust link stage.
#      polly-on-env does not touch LDFLAGS so it is technically safe for
#      Rust, but it is still pointless — Rust entries are clang-lto-env only.
#
#   3. media-libs/mesa gets clang-lto-env ONLY.
#      polly-plugin-env (and polly-on-env) removed: mesa's multilib build
#      path internally iterates over ABIs (multilib_foreach_abi); the 32-bit
#      compilation path tries to dlopen LLVMPolly.so which is ELF64 and
#      cannot be loaded in a 32-bit compilation context — hard build failure.
#
#   4. media-libs/libde265 duplicate removed.
#      Was on line 80 (clang-lto-env only) AND line 85 (polly-on-env).
#      Kept at clang-lto-env polly-on-env only.
#
#   5. llvm-core/polly gets clang-lto-env only (not polly-on-env).
#      Building Polly with itself is unnecessary recursion.
#
#   6. llvm-core/llvm gets clang-lto-env only (not polly-on-env).
#      LLVM itself is the host compiler. Polly transformations on the LLVM
#      codebase can cause excessive compile times with no meaningful runtime
#      benefit for a compiler that runs once at build time.
#
#   7. sci-libs/fftw gets polly-on-env, NOT polly-parallel-env.
#      FFTW has its own internal thread pool (FFTW_NTHREADS). Adding Polly's
#      OpenMP parallel codegen on top creates two competing threading layers.
#
#   8. sci-libs/gsl gets polly-parallel-env.
#      GSL is single-threaded by design (callback-based API). Its numerical
#      integration, ODE, and linear algebra routines have clear nested loop
#      structures that Polly can legitimately parallelize.


# ── LLVM / Clang toolchain ────────────────────────────────────────────────
# polly-on-env applied to all C++ LLVM components (clang, lld, runtimes).
# llvm itself and polly are excluded (see rules 5 and 6 above).
# compiler-rt-sanitizers excluded: sanitizer runtimes are instrumentation
# code; Polly transformations here risk miscompiling the sanitizer itself.

llvm-core/llvm                          clang-lto-env
llvm-core/llvm-common                   clang-lto-env polly-on-env
llvm-core/llvm-toolchain-symlinks       clang-lto-env polly-on-env
llvm-core/clang                         clang-lto-env polly-on-env
llvm-core/clang-common                  clang-lto-env polly-on-env
llvm-core/clang-toolchain-symlinks      clang-lto-env polly-on-env
llvm-core/lld                           clang-lto-env polly-on-env
llvm-core/lld-toolchain-symlinks        clang-lto-env polly-on-env
llvm-core/polly                         clang-lto-env
llvm-runtimes/clang-runtime             clang-lto-env polly-on-env
llvm-runtimes/compiler-rt               clang-lto-env polly-on-env
llvm-runtimes/compiler-rt-sanitizers    clang-lto-env
llvm-runtimes/libunwind                 clang-lto-env polly-on-env
llvm-runtimes/openmp                    clang-lto-env 
dev-util/spirv-llvm-translator          clang-lto-env polly-on-env


# ── GPU / graphics stack ──────────────────────────────────────────────────
# mesa: clang-lto-env ONLY — polly-plugin-env removed (see rule 3).
# shaderc / libplacebo: GPU shader compilation; hot paths run on GPU,
# not CPU loops, so Polly gains nothing meaningful.

media-libs/mesa                         clang-lto-env polly-on-env
dev-util/glslang                        clang-lto-env polly-on-env
media-libs/libdisplay-info              clang-lto-env polly-on-env
media-libs/shaderc                      clang-lto-env
media-libs/libplacebo                   clang-lto-env


# ── Scientific / math ────────────────────────────────────────────────────
# gsl: polly-parallel-env — GSL is single-threaded, no internal pool,
#      has clear nested loop structure in integration / ODE / linalg routines.
# fftw: polly-on-env ONLY — FFTW has its own thread pool, no parallel env.
# gmp: bignum multiply/divide loops have clear polyhedral structure;
#      loop tiling improves cache locality on large integer operations.
# mpfr: built on gmp; same loop characteristics.

sci-libs/gsl                            clang-lto-env polly-parallel-env
sci-libs/fftw                           clang-lto-env polly-on-env
dev-libs/gmp                            clang-lto-env polly-on-env
dev-libs/mpfr                           clang-lto-env polly-on-env
dev-lang/python                         clang-lto-env

# ── Cryptography / security ───────────────────────────────────────────────
# Crypto inner loops (AES, SHA, ChaCha) have clear polyhedral structure
# in the C fallback paths. Clang's vectorizer benefits from Polly's tiling
# hints even when SIMD intrinsics handle the fast path.

dev-libs/openssl                        clang-lto-env polly-on-env
dev-libs/nettle                         clang-lto-env polly-on-env
dev-libs/libgcrypt                      clang-lto-env polly-on-env
dev-libs/libsodium                      clang-lto-env polly-on-env


# ── Core system / runtime libraries ──────────────────────────────────────
# glib: GObject dispatch, GHashTable, GArray — C loops with tight iteration.
# icu: Unicode data table lookups and normalization have C loop structures.
# boost: mostly template metaprogramming; Polly finds few SCoPs. LTO only.
# re2 / libpcre2: automata-based regex engines; NFA/DFA dispatch is complex
#   branchy control flow, not polyhedral. LTO only.
# jemalloc / libgit2: allocator internals and I/O/data-structure traversal;
#   not polyhedral. LTO only.
# xxhash: non-cryptographic hashing; tight inner byte loop — Polly tiling
#   and vectorizer hints improve throughput.
# zlib: DEFLATE inner loops are tight and benefit from tiling/vectorization.
# sqlite: B-tree traversal with complex branching; not polyhedral. LTO only.

dev-libs/glib                           clang-lto-env polly-on-env
dev-libs/icu                            clang-lto-env polly-on-env
dev-libs/boost                          clang-lto-env
dev-libs/re2                            clang-lto-env
dev-libs/libpcre2                       clang-lto-env
dev-libs/jemalloc                       clang-lto-env
dev-libs/libsodium                      clang-lto-env polly-on-env
dev-libs/libgit2                        clang-lto-env
dev-libs/xxhash                         clang-lto-env polly-on-env
sys-libs/zlib                           clang-lto-env polly-on-env
dev-db/sqlite                           clang-lto-env


# ── Compression ───────────────────────────────────────────────────────────
# zstd / lz4 / brotli / xz / snappy: all have tight C inner loops with clear
# iteration spaces (sliding window, hash table scan, entropy coding).
# Polly tiling + vectorizer hints improve throughput on these algorithms.
# libarchive: benefits primarily from ThinLTO cross-module inlining rather
# than loop transformations; LTO only.

app-arch/zstd                           clang-lto-env polly-on-env
app-arch/lz4                            clang-lto-env polly-on-env
app-arch/brotli                         clang-lto-env polly-on-env
app-arch/xz-utils                       clang-lto-env polly-on-env
app-arch/snappy                         clang-lto-env polly-on-env
app-arch/libarchive                     clang-lto-env


# ── Media codecs ──────────────────────────────────────────────────────────
# ffmpeg: C with DSP loops throughout; polly-on-env beneficial.
# dav1d / aom / x264 / libvpx / kvazaar / libvmaf / libde265: video codec
#   inner loops (DCT, motion estimation, entropy coding) are polyhedral.
# libwebp: SIMD-amenable C fallback loops in the encoder/decoder.
# libjpeg-turbo: uses hand-written SIMD assembly for hot paths; Polly cannot
#   optimize assembly. LTO only.
# libjxl: complex C++ codec; has high-level loop structures polly can tile.
# libsndfile: sample format conversion loops are tightly structured.
# lcms2: ICC profile matrix/curve loops benefit from loop tiling.
# libavif: thin wrapper around aom/dav1d; LTO cross-module inlining is the
#   main benefit; Polly gains are marginal here.

media-video/ffmpeg                      clang-lto-env polly-on-env
media-video/libavif                     clang-lto-env
media-libs/dav1d                        clang-lto-env polly-on-env
media-libs/aom                          clang-lto-env polly-on-env
media-libs/x264                         clang-lto-env polly-on-env
media-libs/libvpx                       clang-lto-env polly-on-env
media-libs/kvazaar                      clang-lto-env polly-on-env
media-libs/libvmaf                      clang-lto-env polly-on-env
media-libs/libde265                     clang-lto-env polly-on-env
media-libs/libwebp                      clang-lto-env polly-on-env
media-libs/libjpeg-turbo                clang-lto-env
media-libs/libjxl                       clang-lto-env polly-on-env
media-libs/libsndfile                   clang-lto-env polly-on-env
media-libs/lcms                         clang-lto-env polly-on-env


# ── Audio ─────────────────────────────────────────────────────────────────
# DSP encoding/decoding loops in lame (MP3), opus, libvorbis are polyhedral.
# jack2: audio server; DSP callback path has loop-structured sample processing.

media-sound/jack2                       clang-lto-env polly-on-env
media-sound/lame                        clang-lto-env polly-on-env
media-libs/opus                         clang-lto-env polly-on-env
media-libs/libvorbis                    clang-lto-env polly-on-env


# ── Fonts / text rendering ────────────────────────────────────────────────
# freetype: rasterization scanline loops (anti-aliasing, hinting) are
#   tightly structured and benefit from Polly tiling.
# harfbuzz: OpenType shaping has C loop structures over glyph arrays.
# pixman: pixel compositing inner loops are Polly's canonical target;
#   strip-mine vectorization directly helps compositing throughput.
# cairo: hot rendering paths delegate to pixman; cairo's own C code has
#   limited polyhedral loops. LTO only.
# pango: complex Unicode bidirectional text layout; control-flow-heavy,
#   not polyhedral. LTO only.

media-libs/freetype                     clang-lto-env polly-on-env
media-libs/harfbuzz                     clang-lto-env polly-on-env
x11-libs/pixman                         clang-lto-env polly-on-env
x11-libs/cairo                          clang-lto-env
x11-libs/pango                          clang-lto-env


# ── Networking ────────────────────────────────────────────────────────────
# Protocol parsing and I/O scheduling; not polyhedral. LTO only.

net-libs/curl                           clang-lto-env
net-libs/nghttp2                        clang-lto-env


# ── Desktop / Wayland / UI ────────────────────────────────────────────────
# Compositor and UI toolkit code is event-driven and control-flow-heavy;
# Polly finds few profitable SCoPs. ThinLTO for cross-module inlining.

gui-wm/hyprland                         clang-lto-env
gui-libs/aquamarine                     clang-lto-env
gui-libs/libadwaita                     clang-lto-env
x11-terms/kitty                         clang-lto-env
app-text/zathura                        clang-lto-env
media-video/mpv                         clang-lto-env


# ── Rust toolchain ────────────────────────────────────────────────────────
dev-lang/rust                           clang-lto-env


# ── Pure Rust applications ────────────────────────────────────────────────
# clang-lto-env only. polly flags are inert for rustc (rustc ignores CFLAGS).
# Any env flag in LDFLAGS would become -C link-arg= and risk breaking the
# Rust link stage. polly-on-env does not touch LDFLAGS so it is technically
# safe, but it is still pointless — kept at clang-lto-env for clarity.

app-shells/atuin                        clang-lto-env
app-shells/starship                     clang-lto-env
app-shells/zoxide                       clang-lto-env
app-misc/yazi                           clang-lto-env
gui-apps/alacritty-graphics             clang-lto-env
sys-apps/bat                            clang-lto-env
sys-apps/eza                            clang-lto-env
sys-apps/fd                             clang-lto-env
sys-apps/ripgrep                        clang-lto-env
dev-util/git-delta                      clang-lto-env
dev-util/tree-sitter-cli                clang-lto-env
app-misc/topgrade                       clang-lto-env
app-text/texlab                         clang-lto-env
gnome-base/librsvg                      clang-lto-env
app-containers/pods                     clang-lto-env


# ── Build tools ───────────────────────────────────────────────────────────
# meson: Python build system; clang-lto-env applies to any bundled C
#   extension modules only. polly-on-env removed — no meaningful C loops.
# cmake: built with GCC per system config — no env override.

dev-build/meson                         clang-lto-env
# dev-build/cmake                       # GCC built — intentionally excluded
